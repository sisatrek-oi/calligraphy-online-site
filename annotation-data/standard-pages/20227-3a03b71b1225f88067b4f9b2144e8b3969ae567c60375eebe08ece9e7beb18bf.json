4,195],[195,196],[196,197],[197,198],[198,199],[199,200],[200,201],[207,208],[208,209],[209,210],[210,211],[211,212],[212,213],[213,214],[214,215],[215,216],[216,217],[217,218],[218,219],[225,226],[226,227],[227,228],[228,229],[229,230],[230,231],[231,232],[232,233],[233,234],[234,235],[235,236],[236,237],[237,238],[244,245],[245,246],[246,247],[247,248],[248,249],[249,250],[250,251],[251,252],[252,253],[253,254],[254,255],[255,256],[256,257],[257,258],[258,259],[265,266],[266,267],[267,268],[268,269],[269,270],[270,271],[271,272],[272,273],[273,274],[274,275],[275,276],[276,277],[277,278],[284,285],[285,286],[286,287],[287,288],[288,289],[289,290]],"legacySource":{"kind":"human-txt","page":776,"part":3,"label":"人工审核原TXT","verifiedBy":"彭鹏","verifiedAt":"2026-10-19T11:55:11.911Z","revision":"28b9b3635d3bd2f2e32d8d2bd88e339907cc3fd73b2e6f98e2ea38e6a535706f","textSha256":"28b9b3635d3bd2f2e32d8d2bd88e339907cc3fd73b2e6f98e2ea38e6a535706f","fileSha256":"08604f1942cd7018a3093aab9901d02c5bfcdc39d59d35578ce621c5a1eeefa5","txtPath":"tasks/2026-10-21-review-package-update/extracted/member-7-part-3/第3份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/extracted/member-7-part-3/第3份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/extracted/member-7-part-3/第3份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":5,"quote":"购碑第三\n","role":"structure","category":"结构信息","note":"原分篇题。","contextStatus":"complete"},{"start":5,"end":7,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":7,"end":278,"quote":"学者欲能书，当得通人以为师，然通人不可多得。吾为学者寻师，其莫如多购碑刻乎。\n杨子云曰：「能观千剑，而后能剑；能读千赋，而后能赋。」仲尼、子舆论学，必先博学详说。夫耳目隘陋，无以备其体裁，博其神趣，学乌乎成！若所见博，所临多，熟古今之体变，通源流之分合，尽得于目，尽存于心，尽应于手，如蜂采花，酝酿久之，变化纵横，自有成效。断非枯守一二佳本《兰亭》、《醴泉》所能知也。右军自言见李斯、曹喜、梁鹄、蔡邕《石经》、张昶《华岳碑》，遍习之。是其师资甚博，岂师一卫夫人，法一《宣示表》，遂能范围千古哉！学者若能见千碑而好临之，而不能书者，未之有也。\n","role":"theory","category":"学书方法","note":"以购碑代寻师，博见多临融会体变源流，援王羲之博学故事。","contextStatus":"complete"},{"start":278,"end":280,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":280,"end":450,"quote":"千碑不易购，亦不易见。然则如何？曰：握要以图之，择精以求之，得百碑亦可成书。\n然言百碑，其约至矣，不能复更少矣。不知其要，不择其精，虽见数百碑，犹未足语于斯道也。吾闻人能书者，辄言写欧写颜，不则言写某朝某碑。此真谬说，令天下人终身学书，而无所就者，此说误之也。至写欧则专写一本，写颜亦专写一本，欲以终身，此尤谬之尤谬，误天下学者，在此也。\n","role":"theory","category":"学书方法","note":"由千碑收至择精百碑，反对终身专一碑或一家。","contextStatus":"complete"},{"start":450,"end":452,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":452,"end":735,"quote":"又有谓学书须专学一碑数十字，如是一年数月，临写千数百过，然后易一碑，又一年数月，临写千数百过，然后易碑亦如是。因举锺元常入抱犊山三年学书，永禅师学书四十年不下楼为例。此说似矣，亦谬说也！夫学者之于文艺，末事也；书之工拙，又艺之至微下者也。学者蓄德器，穷学问，其事至繁，安能以有用之岁月，耗之于无用之末艺乎？诚如锺、永，又安有暇日涉问学哉？此殆言者欺人耳。吾之术以能执笔、多见碑为先务，然后辨其流派，择其精奇，惟吾意之所欲，以时临之。碑临旬月，遍临百碑，自能酿成一体，不期其然而自然者。加之熟巧，申之学问，已可成家。虽天才驽下，无有不立，若其浅深高下，则仍视其人耳。\n","role":"theory","category":"学书方法","note":"反对每碑多年千遍，以执笔博见择奇、遍临酿体并学问为术。","contextStatus":"complete"},{"start":735,"end":737,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":737,"end":1038,"quote":"购碑当知握要，以何为要也？曰：南、北朝之碑，其要也。南、北朝之碑，无体不备，唐人名家，皆从此出，得其本矣，不必复求其末，下至于禄之体，亦无不兼存。故唐碑可以缓购。且唐碑名家之佳者，如率更之《化度》、《九成宫》、《皇甫君》、《虞恭公》，秘书之《庙堂碑》，河南之《圣教序》、《孟达法师》，鲁公之《家庙》、《麻姑坛》、《多宝塔》、《元结》、《郭家庙》、《臧怀恪》、《殷君》、《八关齋》，李北海之《云麾将军》、《灵岩》、《东林寺》、《端州石室》，徐季海之《不空和尚》，柳诚悬之《元秘塔》、《冯宿》诸碑，非原石不存，则磨翻坏尽；稍求元、明之旧拓，不堪入目，已索百金。岂若以此一本之貲，尽购南、北朝诸碑乎？若舍诸名","role":"theory","category":"学书方法","note":"主张南北朝为本、唐碑可缓购，列唐名碑损坏与旧拓昂贵；论证跨771页。","contextStatus":"needs-context"},{"start":1038,"end":1040,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1040,"end":1153,"quote":"家佳本，而杂求散碑，则又本末倒置，昧于源流。且佳碑如《樊府君》、《兗公颂》、《裴镜民》者实寡。小唐碑中，颇多六朝体，是其沿用未变法者，原可采择，惟意态体格，六朝碑皆已备之。唐碑可学者殊少，即学之，体格已卑下也，故唐碑可缓购。\n","role":"theory","category":"学书方法","note":"承770页反对舍唐名家佳本而求散碑，谓六朝已备故缓购唐碑。","contextStatus":"needs-context"},{"start":1153,"end":1155,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1155,"end":1238,"quote":"今世所用号称真楷者，六朝人最工。盖承汉分之余，古意未变，质实厚重，宕逸神隽，又下开唐人法度，草情隶韵，无所不有。晋帖吾不得见矣，得尽见六朝佳碑可矣。故六朝碑宜多购。\n","role":"theory","category":"审美风格","note":"评六朝真楷质厚宕逸、兼草情隶韵，宜多购六朝。","contextStatus":"complete"},{"start":1238,"end":1240,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1240,"end":1310,"quote":"汉分为真楷之源，以之考古，固为学问之事。即论书法，亦当考索源流，宜择其要购之。若六朝之隶无多，唐隶流传日卑，但略见之，知流变足矣。可不购。\n","role":"theory","category":"学书方法","note":"因源流宜择汉分，而六朝隶少唐隶卑，略见可不购。","contextStatus":"complete"},{"start":1310,"end":1312,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1312,"end":1543,"quote":"汉分既择求，唐隶在所不购，则自魏、晋至隋，其碑不多，可以按《金石萃编》、《金石补编《金石索》《金石聚》而求之，可以分各省存碑而求之。然道、咸、同、光，新碑日出，箸录者各有不尽。学者或限于见闻，或困于才力，无以知其目而购之；知其目矣，虑碑之繁多，搜之而无尽也。吾为说曰：六朝碑之杂沓繁冗者，莫如造像记。其文义略同，所足备考古者盖鲜，陈陈相因，殊为可厌。此盖出土之日新，不可究尽者也。造像记中多佳者，然学者未能择也，姑俟碑铭尽搜之后，乃次择采之。故造像记亦可缓购。\n","role":"theory","category":"学书方法","note":"说明按金石书与存地求碑，造像记虽多佳而初学难择，故缓购。","contextStatus":"complete"},{"start":1543,"end":1545,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1545,"end":1583,"quote":"去唐碑，去散隶，去六朝造像记，则六朝所存碑铭不过百馀，兼以秦、汉分书佳者数十","role":"theory","category":"学书方法","note":"汇总排除后推荐碑目数量，句接772页。","contextStatus":"needs-context"},{"start":1583,"end":1585,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1585,"end":1737,"quote":"本，通不过二百馀种。必尽求之，会通其源流，浸淫于心目，择吾所爱好者临之，厌则去之。\n临写既多，变化无尽，方圆操纵，融治自成体裁韵味，必可绝俗，学者固可自得之也。秦、汉分目，略见所说《说分》、《本汉》篇中，今将南、北朝碑目必当购者，录如左。其碑多新出，为金石诸书所未有者也；造像记佳者，亦附目，间下论焉。\n","role":"theory","category":"学书方法","note":"承771页总数，主张尽求会源流择所好临并说明碑目录入范围。","contextStatus":"needs-context"},{"start":1737,"end":1739,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1739,"end":1833,"quote":"碑以朝别，以年叙，其无可考，附于其朝之后。\n有年则书；不书者，无年月也。\n书人详之，撰人不详，重在书也。\n石所存地著之；不著者，不知所在也。\n其碑显者书人名，不显者并官书之，欲人易购也。\n","role":"theory","category":"书史书体","note":"说明推荐碑目以朝年代序、著书人存地的著录规则。","contextStatus":"complete"},{"start":1833,"end":1835,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1835,"end":1838,"quote":"吴碑\n","role":"structure","category":"结构信息","note":"原碑目朝代小题。","contextStatus":"complete"},{"start":1838,"end":1840,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1840,"end":1867,"quote":"《葛府君碑》江苏句容。\n《九真太守谷朗碑》凤皇元年。\n","role":"structure","category":"推荐碑目","note":"原文推荐目录，列吴碑名称、存地年代，不当作独立评价句。","contextStatus":"complete"},{"start":1867,"end":1869,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1869,"end":1872,"quote":"晋碑\n","role":"structure","category":"结构信息","note":"原碑目朝代小题。","contextStatus":"complete"},{"start":1872,"end":1874,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1874,"end":1904,"quote":"《南乡太守郛休碑》太始六年。\n《保母志》兴宁三年，王献之书。","role":"structure","category":"推荐碑目","note":"原文晋碑推荐目录，保留题名、年代和书人。","contextStatus":"complete"},{"start":1904,"end":1906,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1906,"end":2085,"quote":"《北海王太妃高为孙保造像》《长乐王夫人尉迟造像》太和十九年。\n《一弗造像》太和廿年。\n《解伯达造像》太和年造。\n《杨大眼造像》《魏灵藏造像》《郑长猷造像》景明二年。\n《惠感造像》景明三年。\n《贺兰汗造像》景明三年。\n《高树造像》景明三年。\n《法生造像》景明四年。\n《太妃侯造像》景明四年。\n《安定王元燮造像》正始四年。\n《平乾虎造像》正始四年。\n《道匠造像》","role":"structure","category":"推荐碑目","note":"连续原文造像碑目，列题名及年款；不把题名当独立论断或另立作品章节。","contextStatus":"needs-context"}],"candidates":[{"id":"W20227-0001","start":7,"end":278,"quote":"学者欲能书，当得通人以为师，然通人不可多得。吾为学者寻师，其莫如多购碑刻乎。\n杨子云曰：「能观千剑，而后能剑；能读千赋，而后能赋。」仲尼、子舆论学，必先博学详说。夫耳目隘陋，无以备其体裁，博其神趣，学乌乎成！若所见博，所临多，熟古今之体变，通源流之分合，尽得于目，尽存于心，尽应于手，如蜂采花，酝酿久之，变化纵横，自有成效。断非枯守一二佳本《兰亭》、《醴泉》所能知也。右军自言见李斯、曹喜、梁鹄、蔡邕《石经》、张昶《华岳碑》，遍习之。是其师资甚博，岂师一卫夫人，法一《宣示表》，遂能范围千古哉！学者若能见千碑而好临之，而不能书者，未之有也。\n","category":"学书方法","note":"以购碑代寻师，博见多临融会体变源流，援王羲之博学故事。","contextStatus":"complete"},{"id":"W20227-0002","start":280,"end":450,"quote":"千碑不易购，亦不易见。然则如何？曰：握要以图之，择精以求之，得百碑亦可成书。\n然言百碑，其约至矣，不能复更少矣。不知其要，不择其精，虽见数百碑，犹未足语于斯道也。吾闻人能书者，辄言写欧写颜，不则言写某朝某碑。此真谬说，令天下人终身学书，而无所就者，此说误之也。至写欧则专写一本，写颜亦专写一本，欲以终身，此尤谬之尤谬，误天下学者，在此也。\n","category":"学书方法","note":"由千碑收至择精百碑，反对终身专一碑或一家。","contextStatus":"complete"},{"id":"W20227-0003","start":452,"end":735,"quote":"又有谓学书须专学一碑数十字，如是一年数月，临写千数百过，然后易一碑，又一年数月，临写千数百过，然后易碑亦如是。因举锺元常入抱犊山三年学书，永禅师学书四十年不下楼为例。此说似矣，亦谬说也！夫学者之于文艺，末事也；书之工拙，又艺之至微下者也。学者蓄德器，穷学问，其事至繁，安能以有用之岁月，耗之于无用之末艺乎？诚如锺、永，又安有暇日涉问学哉？此殆言者欺人耳。吾之术以能执笔、多见碑为先务，然后辨其流派，择其精奇，惟吾意之所欲，以时临之。碑临旬月，遍临百碑，自能酿成一体，不期其然而自然者。加之熟巧，申之学问，已可成家。虽天才驽下，无有不立，若其浅深高下，则仍视其人耳。\n","category":"学书方法","note":"反对每碑多年千遍，以执笔博见择奇、遍临酿体并学问为术。","contextStatus":"complete"},{"id":"W20227-0004","start":737,"end":1038,"quote":"购碑当知握要，以何为要也？曰：南、北朝之碑，其要也。南、北朝之碑，无体不备，唐人名家，皆从此出，得其本矣，不必复求其末，下至于禄之体，亦无不兼存。故唐碑可以缓购。且唐碑名家之佳者，如率更之《化度》、《九成宫》、《皇甫君》、《虞恭公》，秘书之《庙堂碑》，河南之《圣教序》、《孟达法师》，鲁公之《家庙》、《麻姑坛》、《多宝塔》、《元结》、《郭家庙》、《臧怀恪》、《殷君》、《八关齋》，李北海之《云麾将军》、《灵岩》、《东林寺》、《端州石室》，徐季海之《不空和尚》，柳诚悬之《元秘塔》、《冯宿》诸碑，非原石不存，则磨翻坏尽；稍求元、明之旧拓，不堪入目，已索百金。岂若以此一本之貲，尽购南、北朝诸碑乎？若舍诸名","category":"学书方法","note":"主张南北朝为本、唐碑可缓购，列唐名碑损坏与旧拓昂贵；论证跨771页。","contextStatus":"needs-context"},{"id":"W20227-0005","start":1040,"end":1153,"quote":"家佳本，而杂求散碑，则又本末倒置，昧于源流。且佳碑如《樊府君》、《兗公颂》、《裴镜民》者实寡。小唐碑中，颇多六朝体，是其沿用未变法者，原可采择，惟意态体格，六朝碑皆已备之。唐碑可学者殊少，即学之，体格已卑下也，故唐碑可缓购。\n","category":"学书方法","note":"承770页反对舍唐名家佳本而求散碑，谓六朝已备故缓购唐碑。","contextStatus":"needs-context"},{"id":"W20227-0006","start":1155,"end":1238,"quote":"今世所用号称真楷者，六朝人最工。盖承汉分之余，古意未变，质实厚重，宕逸神隽，又下开唐人法度，草情隶韵，无所不有。晋帖吾不得见矣，得尽见六朝佳碑可矣。故六朝碑宜多购。\n","category":"审美风格","note":"评六朝真楷质厚宕逸、兼草情隶韵，宜多购六朝。","contextStatus":"complete"},{"id":"W20227-0007","start":1240,"end":1310,"quote":"汉分为真楷之源，以之考古，固为学问之事。即论书法，亦当考索源流，宜择其要购之。若六朝之隶无多，唐隶流传日卑，但略见之，知流变足矣。可不购。\n","category":"学书方法","note":"因源流宜择汉分，而六朝隶少唐隶卑，略见可不购。","contextStatus":"complete"},{"id":"W20227-0008","start":1312,"end":1