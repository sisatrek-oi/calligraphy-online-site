mplete"},{"id":"W20041-0015","start":359,"end":378,"quote":"颜蒨书如贫家果实,无妨可爱,少乏珍羞。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0016","start":380,"end":396,"quote":"阮研书如贵胄失品,不复排斥英贤。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0017","start":398,"end":422,"quote":"王褒书悽断风流,而势不称貌,意深工浅,犹未当妙。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0018","start":424,"end":440,"quote":"师宜官书如鹏翔未息,翩翩而自逝。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0019","start":442,"end":466,"quote":"陶隐居书如吴兴小儿,形状虽未成长,而骨体甚峭快。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0020","start":468,"end":481,"quote":"钟会书有十二意,意外奇妙。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0021","start":483,"end":508,"quote":"萧特书虽有家风,而风流势薄,犹如羲、献,安得相似。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0022","start":510,"end":524,"quote":"王彬之书放纵快利,笔道流便。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0023","start":526,"end":548,"quote":"范怀约真书有力,而草、行无功,故知简牍非易。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0024","start":550,"end":574,"quote":"郗愔书得意甚熟,而取妙特难,疏散风气,一无雅素。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0025","start":576,"end":595,"quote":"柳恽书纵横廓落,大意不凡,而德本未备。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0026","start":597,"end":623,"quote":"庚肩吾书畏惧收敛,少得自充,观阮未精,去萧、蔡远矣。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0027","start":625,"end":640,"quote":"孔琳之书如散花空中,流徽自得。","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"id":"W20041-0028","start":642,"end":663,"q