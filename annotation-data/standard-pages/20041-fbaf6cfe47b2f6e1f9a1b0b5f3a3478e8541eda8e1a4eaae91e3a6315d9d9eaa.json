tart":256,"end":285,"quote":"王僧虔书如王、谢家子弟,纵复不端正,奕奕皆有一种风流气骨。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":285,"end":287,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":287,"end":314,"quote":"程旷平书如鸿鹄高飞,弄翅颉颃。又如轻云忽散,乍见白日。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":314,"end":316,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":316,"end":331,"quote":"李岩之书如镂金素月,屈玉自照。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":331,"end":333,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":333,"end":357,"quote":"吴施书如新亭伧父,一往见似扬州人,共语语便态出。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":357,"end":359,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":359,"end":378,"quote":"颜蒨书如贫家果实,无妨可爱,少乏珍羞。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":378,"end":380,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":380,"end":396,"quote":"阮研书如贵胄失品,不复排斥英贤。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":396,"end":398,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":398,"end":422,"quote":"王褒书悽断风流,而势不称貌,意深工浅,犹未当妙。","role":"theory","category":"书家评价","note":"对具体书家的风流、笔势、神骨与工拙进行品评","contextStatus":"complete"},{"start":422,"end":424,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":424,"end":440,"quote":"师宜官书如鹏翔未息,翩翩而自逝。","role":"theory","category":"书家评价","