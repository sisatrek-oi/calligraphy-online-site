update/extracted/member-1-part-1/第1份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/extracted/member-1-part-1/第1份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/extracted/member-1-part-1/第1份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":4,"quote":"王僧虔\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":4,"end":6,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":6,"end":37,"quote":"宋文帝书，自谓不减王子敬。时议者云：“天然胜羊欣，功夫不及欣。","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":37,"end":39,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":39,"end":122,"quote":"王平南廙（王廙），是右军叔。自过江东，右军之前，惟廙为最，画为晋明帝师，书为右军法。  \n亡曾祖领军洽与右军俱变古形，不尔，至今犹法钟、张。右军云：“而书遂不减吾。”","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":122,"end":124,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":124,"end":194,"quote":"亡从祖中书令氓，笔力过于子敬。书《旧品》云：“有四疋素，自朝操笔，至暮便竟，首尾如一，又无误字。子敬戏云：‘弟书如骑骡，骎骎恒欲度骅骝前。”","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":194,"end":196,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":196,"end":261,"quote":"庾征西翼（庾翼）书，少时与右军齐名。右军后进，庾犹不忿。在荆州与都下书云：“小儿辈乃贱家鸡，爱野鸯，皆学逸少书。须吾还，当比之。”","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":261,"end":263,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":263,"end":306,"quote":"张翼书右军自书表，晋穆帝令翼写题后答右军，右军当时不别，久方觉，云：“小于几欲乱真。”","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":306,"end":308,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":308,"end":351,"quote":"张芝、索靖、韦诞、钟会、二卫并得名前代，古今既异，无以辨其优劣，惟见笔力惊绝耳。   ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":351,"end":353,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":353,"end":367,"quote":"张澄书，当时亦呼有意。   ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":367,"end":369,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":369,"end":382,"quote":"郗方回章草，亚于右军。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":382,"end":384,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":384,"end":400,"quote":"晋齐王侦书，京、洛以为楷法。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":400,"end":402,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":402,"end":433,"quote":"李式书，右军云：“是平南之流，可比庾翼；王濛书，亦可比庾翼。”","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":433,"end":435,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":435,"end":453,"quote":"陆机书，吴士书也，无以校其多少。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":453,"end":455,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":455,"end":466,"quote":"庾亮书，亦能入录。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":466,"end":468,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":468,"end":557,"quote":"亡高祖丞相导（王导），亦甚有楷法，以师钟、卫，好爱无厌，丧乱狼狈，犹以钟繇《尚书宣示帖》藏衣带中。过江后，在右军处，右军借王敬仁（王修）。敬仁死，其母见修平生所爱，遂以入棺。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":557,"end":559,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":559,"end":582,"quote":"郗超草书亚于二王，紧媚过其父，骨力不及也。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":582,"end":584,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":584,"end":608,"quote":"桓玄书，自比右军，议者未之许，云可比孔琳之。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":608,"end":610,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":610,"end":645,"quote":"谢安亦入能流，殊亦自重，乃为子敬书嵇中散诗。得子敬书，有时裂作校纸。 ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":645,"end":647,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":647,"end":727,"quote":"羊欣、邱道护并亲授于子敬。欣书见重一时，行草尤善，正乃不称。孔琳之书，天然绝逸，极有笔力，规矩恐在羊欣后。邱道护与羊欣皆面授子敬，故当在欣后，邱殊在羊欣前。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":727,"end":729,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":729,"end":757,"quote":"范晔、萧思话同师羊欣，范后背叛，皆失故步，名亦稍退。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":757,"end":759,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":759,"end":785,"quote":"萧思话全法羊欣，风流趣好，殆当不减，而笔力恨弱。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":785,"end":787,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":787,"end":865,"quote":"谢灵运书乃不伦，遇其合时，亦得入能流。昔子敬上表多在中书杂事中，皆自书，窃易真本，相与不疑。元嘉初，方就索还。《上谢太傅殊礼表》亦是其例，亲闻文皇说此。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":865,"end":867,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":867,"end":910,"quote":"谢综书，其舅云：“紧洁生起，实为得赏。”至不重羊欣，欣亦惮之。书法有力，恨少媚好。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":910,"end":912,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":912,"end":926,"quote":"颜腾之、贺道力并便尺牍。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":926,"end":928,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":928,"end":954,"quote":"康听学右军草，亦欲乱真，与南州释道人作右军书赞。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":954,"end":956,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":956,"end":1003,"quote":"孔琳之书，放纵快利，笔道流便，二王后略无其比。但工夫少，自任过，未得尽其妙，故当劣于羊欣。  ","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":1003,"end":1005,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1005,"end":1040,"quote":"谢静、谢敷并善写经，亦入能境。居钟毫之美，迈古流今，是以征南还即所得。","role":"theory","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"start":1040,"end":1042,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1042,"end":1520,"quote":"又论书辱告并五纸，举体精隽灵奥，执玩反覆，不能释手。虽太傅之婉媚玩好，领军之静逖合绪，方之蔑如也。昔杜度杀字甚安，而笔体微瘦；崔瑗笔势甚快，而结字小疏。居处二者之间，亦犹仲尼方于季、孟也。夫工欲善其事，必先利其器。伯喈非流纨体素，不妄下笔。若子邑之纸，研染辉光；仲将之墨，一点如漆；伯英之笔，穷神静思。妙物远矣，邈不可追，遂令思挫于弱毫，数屈于陋墨，言之使人于邑。若三珍尚存，四宝斯觌，何但尺素信札，动见模式，将一字径文，方寸千言也。承天凉体豫，复欲缮写一赋，倾迟辉采，心目俱劳。承见模式，将一字径丈，方寸千言也。承天凉体豫，复欲缮写一赋，倾迟辉采，心目俱劳。承阅秘府，备睹群迹，崔、张归美于逸少，虽一代所宗，仆不见前古人之迹，计亦无以过于逸少。既妙尽深绝，便当得之实录，然观前世称目，窃有疑焉。崔、杜之后，共推张芝，仲将谓之笔圣，伯玉得其筋，巨山得其骨。索氏自谓其书银钩虿尾，谈者诚得其宗。刘德升为钟、胡所师，两贤并有肥瘦之断。元鸣获钉壁之玩，师宜致酒简之多，此亦不能止长允狸骨，右军以为绝伦，其功不可及。由此言之，则向之论或至投杖，聊呈一笑，不妄言耳。","role":"theory","category":"书家评价","note":"比较书家或自评笔意，部分兼生平与用笔。","contextStatus":"complete"},{"start":1520,"end":1522,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1522,"end":1583,"quote":"钟公之书谓之尽妙，钟有三体：一曰铭石书，最妙者也；二曰章程书，世传秘书，教小学者也；三曰行狎书，行书是也。三法皆世人所善。","role":"theory","category":"书史书体","note":"叙书体源流及分类；含书家评价和编纂缘起。","contextStatus":"complete"},{"start":1583,"end":1585,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1585,"end":1594,"quote":"起字子益，河间人。","role":"biography","category":"背景生平","note":"身份记述及题榜轶事，未展开书学论证。","contextStatus":"complete"},{"start":1594,"end":1596,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1596,"end":1743,"quote":"卫觊字伯儒，河东人，为魏尚书、仆射，谥敬侯。善草书及古文，略尽其妙。草体伤瘦而笔迹精佚，亦行于代。子瑾，字伯玉，晋司空、太保，为楚王所害。瑾采张芝草法，取父书参之，更为草蒿，世传其善。瑾子恒，字巨山，亦能书。索靖字幼安，敦煌人，散骑常侍张芝姊之孙也。传芝草而形异，甚矜其书，名其字势曰银钩虿尾。","role":"theory","category":"书家评价","note":"比较书家或自评笔意，部分兼生平与用笔。","contextStatus":"complete"},{"start":1743,"end":1745,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1745,"end":1834,"quote":"韦诞字仲将，京兆人，善楷书，汉、魏宫观题署，多出其手。魏明帝起凌云台，先钉榜未题，笼盛诞，辘轳长亘引上，使就榜题。榜去地二十五丈，诞危惧，诫子孙绝此楷法，又著之家令。官至大鸿胪。","role":"biography","category":"背景生平","note":"身份记述及题榜轶事，未展开书学论证。","contextStatus":"complete"},{"start":1834,"end":1836,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1836,"end":1979,"quote":"王僧虔（四二六年——四八五年），南朝齐书法家。琅邪临沂（今属山东）人，官至侍中，谥简穆。喜文史，善音律，工书。孝武帝欲擅书名，僧虔不敢暴露其能，常用拙笔写字，以此见容。齐太祖尝与赌书，书毕，问曰：「谁为第一？」僧虔曰：「臣书臣中第一，陛下书帝中第一。」太祖笑曰：「卿可谓善自为谋矣。」\n","role":"biography","category":"人物生平","note":"编者叙生平与帝王争书名逸事，保留在人物介绍层。","contextStatus":"complete"},{"start":1979,"end":1981,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1981,"end":2179,"quote":"《论书》一篇，选自《书苑菁华》第十一卷。此篇文有脱误，朱长文辑《墨池编》因分为二，于其第二篇后注曰：「此篇当是僧虔与人书耳。《法书要录》与前篇合为一，非也。」《书画书录解题》曰：「是本为一篇无疑，当即《答竟陵王之书》，朱氏强分为二，非是。」《宋史·艺文志》及《玉海》四十五引书目有僧虔《评书》一卷，当即是编。\n《笔意赞》一篇，选自《书苑菁华》第十八卷。题下汝瑮案：「《图书集成》作齐王僧虔撰。」\n","role":"editorial","category":"编者题解","note":"编者考辨论书篇目分合与笔意赞传本来源。","contextStatus":"complete"},{"start":2179,"end":2181,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2181,"end":2184,"quote":"论书\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":2184,"end":2186,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2186,"end":2190,"quote":"又论书\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"}],"candidates":[{"id":"W20032-0001","start":6,"end":37,"quote":"宋文帝书，自谓不减王子敬。时议者云：“天然胜羊欣，功夫不及欣。","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0002","start":39,"end":122,"quote":"王平南廙（王廙），是右军叔。自过江东，右军之前，惟廙为最，画为晋明帝师，书为右军法。  \n亡曾祖领军洽与右军俱变古形，不尔，至今犹法钟、张。右军云：“而书遂不减吾。”","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0003","start":124,"end":194,"quote":"亡从祖中书令氓，笔力过于子敬。书《旧品》云：“有四疋素，自朝操笔，至暮便竟，首尾如一，又无误字。子敬戏云：‘弟书如骑骡，骎骎恒欲度骅骝前。”","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0004","start":196,"end":261,"quote":"庾征西翼（庾翼）书，少时与右军齐名。右军后进，庾犹不忿。在荆州与都下书云：“小儿辈乃贱家鸡，爱野鸯，皆学逸少书。须吾还，当比之。”","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0005","start":263,"end":306,"quote":"张翼书右军自书表，晋穆帝令翼写题后答右军，右军当时不别，久方觉，云：“小于几欲乱真。”","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0006","start":308,"end":351,"quote":"张芝、索靖、韦诞、钟会、二卫并得名前代，古今既异，无以辨其优劣，惟见笔力惊绝耳。   ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0007","start":353,"end":367,"quote":"张澄书，当时亦呼有意。   ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0008","start":369,"end":382,"quote":"郗方回章草，亚于右军。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0009","start":384,"end":400,"quote":"晋齐王侦书，京、洛以为楷法。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0010","start":402,"end":433,"quote":"李式书，右军云：“是平南之流，可比庾翼；王濛书，亦可比庾翼。”","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0011","start":435,"end":453,"quote":"陆机书，吴士书也，无以校其多少。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0012","start":455,"end":466,"quote":"庾亮书，亦能入录。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0013","start":468,"end":557,"quote":"亡高祖丞相导（王导），亦甚有楷法，以师钟、卫，好爱无厌，丧乱狼狈，犹以钟繇《尚书宣示帖》藏衣带中。过江后，在右军处，右军借王敬仁（王修）。敬仁死，其母见修平生所爱，遂以入棺。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0014","start":559,"end":582,"quote":"郗超草书亚于二王，紧媚过其父，骨力不及也。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0015","start":584,"end":608,"quote":"桓玄书，自比右军，议者未之许，云可比孔琳之。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0016","start":610,"end":645,"quote":"谢安亦入能流，殊亦自重，乃为子敬书嵇中散诗。得子敬书，有时裂作校纸。 ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0017","start":647,"end":727,"quote":"羊欣、邱道护并亲授于子敬。欣书见重一时，行草尤善，正乃不称。孔琳之书，天然绝逸，极有笔力，规矩恐在羊欣后。邱道护与羊欣皆面授子敬，故当在欣后，邱殊在羊欣前。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0018","start":729,"end":757,"quote":"范晔、萧思话同师羊欣，范后背叛，皆失故步，名亦稍退。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0019","start":759,"end":785,"quote":"萧思话全法羊欣，风流趣好，殆当不减，而笔力恨弱。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0020","start":787,"end":865,"quote":"谢灵运书乃不伦，遇其合时，亦得入能流。昔子敬上表多在中书杂事中，皆自书，窃易真本，相与不疑。元嘉初，方就索还。《上谢太傅殊礼表》亦是其例，亲闻文皇说此。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0021","start":867,"end":910,"quote":"谢综书，其舅云：“紧洁生起，实为得赏。”至不重羊欣，欣亦惮之。书法有力，恨少媚好。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0022","start":912,"end":926,"quote":"颜腾之、贺道力并便尺牍。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0023","start":928,"end":954,"quote":"康听学右军草，亦欲乱真，与南州释道人作右军书赞。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0024","start":956,"end":1003,"quote":"孔琳之书，放纵快利，笔道流便，二王后略无其比。但工夫少，自任过，未得尽其妙，故当劣于羊欣。  ","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0025","start":1005,"end":1040,"quote":"谢静、谢敷并善写经，亦入能境。居钟毫之美，迈古流今，是以征南还即所得。","category":"书家评价","note":"具体评书家笔力、师法或风格，兼有相关轶事。","contextStatus":"complete"},{"id":"W20032-0026","start":1042,"end":1520,"quote":"又论书辱告并五纸，举体精隽灵奥，执玩反覆，不能释手。虽太傅之婉媚玩好，领军之静逖合绪，方之蔑如也。昔杜度杀字甚安，而笔体微瘦；崔瑗笔势甚快，而结字小疏。居处二者之间，亦犹仲尼方于季、孟也。夫工欲善其事，必先利其器。伯喈非流纨体素，不妄下笔。若子邑之纸，研染辉光；仲将之墨，一点如漆；伯英之笔，穷神静思。妙物远矣，邈不可追，遂令思挫于弱毫，数屈于陋墨，言之使人于邑。若三珍尚存，四宝斯觌，何但尺素信札，动见模式，将一字径文，方寸千言也。承天凉体豫，复欲缮写一赋，倾迟辉采，心目俱劳。承见模式，将一字径丈，方寸千言也。承天凉体豫，复欲缮写一赋，倾迟辉采，心目俱劳。承阅秘府，备睹群迹，崔、张归美于逸少，虽一代所宗，仆不见前古人之迹，计亦无以过于逸少。既妙尽深绝，便当得之实录，然观前世称目，窃有疑焉。崔、杜之后，共推张芝，仲将谓之笔圣，伯玉得其筋，巨山得其骨。索氏自谓其书银钩虿尾，谈者诚得其宗。刘德升为钟、胡所师，两贤并有肥瘦之断。元鸣获钉壁之玩，师宜致酒简之多，此亦不能止长允狸骨，右军以为绝伦，其功不可及。由此言之，则向之论或至投杖，聊呈一笑，不妄言耳。","category":"书家评价","note":"比较书家或自评笔意，部分兼生平与用笔。","contextStatus":"complete"},{"id":"W20032-0027","start":1522,"end":1583,"quote":"钟公之书谓之尽妙，钟有三体：一曰铭石书，最妙者也；二曰章程书，世传秘书，教小学者也；三曰行狎书，行书是也。三法皆世人所善。","category":"书史书体","note":"叙书体源流及分类；含书家评价和编纂缘起。","contextStatus":"complete"},{"id":"W20032-0028","start":1596,"end":1743,"quote":"卫觊字伯儒，河东人，为魏尚书、仆射，谥敬侯。善草书及古文，略尽其妙。草体伤瘦而笔迹精佚，亦行于代。子瑾，字伯玉，晋司空、太保，为楚王所害。瑾采张芝草法，取父书参之，更为草蒿，世传其善。瑾子恒，字巨山，亦能书。索靖字幼安，敦煌人，散骑常侍张芝姊之孙也。传芝草而形异，甚矜其书，名其字势曰银钩虿尾。","category":"书家评价","note":"比较书家或自评笔意，部分兼生平与用笔。","contextStatus":"complete"}],"contextNotes":[],"summary":"wolai优先标准；仅本地独有段落明确保留。AI初标等待整章通读。","annotationRevision":"ddf6c328d3b992d63ed0f99194c894014070ddcf0bd970da31b288af7963182c"}