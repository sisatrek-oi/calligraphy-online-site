2:48:33.937Z","revision":"123f968f661e02630287a65cab0614d828ab0d40bf9c7947dbb5bc11bfb6c259","textSha256":"123f968f661e02630287a65cab0614d828ab0d40bf9c7947dbb5bc11bfb6c259","fileSha256":"1185f1a3fa26a44f344bcc8de1c99f9576cacd75c8b6baf2d2fd9087b7e29e57","txtPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":6,"quote":"卑唐第十二\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":6,"end":8,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":8,"end":256,"quote":"殷、周以前，文字新创，虽有工拙，莫可考稽。南、北朝诸家，则春秋群贤，战国诸子，当殷、周之末运，极学术之异变，九流并出，万马齐鸣，人才之奇，后世无有。自汉以后，皆度内之人，言理不深，言才不肆，进比战国，倜乎已远，不足复为辜较。书有南、北朝，隶、楷、行草，体变各极，奇伟婉丽，意态斯备，至矣！观斯止矣。至于有唐，虽设书学，士大夫讲之尤甚。然缵承陈、隋之馀，缀其遗绪之一二，不复能变，专讲结构，几若算子。截鹤续凫，整齐过甚。欧、虞、褚、薛，笔法虽未尽亡，然浇淳散朴，古意已漓；而颜、柳迭奏，澌灭尽矣！米","role":"theory","category":"论争辨析","note":"以诸子百家喻六朝书体竞变，批唐碑专结构整齐过甚、古意渐漓，接米芾之评处跨未准入页。","contextStatus":"needs-context"},{"start":256,"end":258,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":258,"end":652,"quote":"洛仁碑》极似《贺若谊》。贾赝福《大云寺》亦有六朝遗意。《灵琛禅师灰身塔文》，笔画丰厚古朴，结体亦大小有趣。《郝贵造像》峻朴，是魏法。《马君起浮图》分行结字，变态无尽。\n《韦利涉造像》遒媚俊逸。《顺陵残碑》浑古有法，若《华山精享碑题名》、王绍宗《王征君临终口授铭》、《独孤仁政碑》、《张宗碑》、《敬善寺碑》、《于孝显碑》、《法藏禅师塔铭》，皆步趋隋碑，为《宁贙》、《舍利塔》、《苏慈碑》之嗣法者。至小碑中若《王仲堪墓志》，体裁峻绝；《王留墓志》，精秀无匹。《李夫人》、《贾嫔墓志》，劲折在《刘玉》、《兖公颂》之间；《常流残石》朴茂在《吕望》、《敬显儁》之间。《韦夫人志》超浑在《王偃》、《李仲璇》之间。《一切如来心真言》，神似《刁遵》。《太常寺丞张锐志》，圆劲在《刁遵》、《曹子建》之间。《张氏墓志》骨血峻秀。《张君浮图志》体峻而美。《焦璀墓志》茂密有魏风。此类甚多，皆工绝，不失六朝矩矱，","role":"theory","category":"作品评价","note":"承未准入页列唐小碑，以风格笔法对照六朝，认为诸碑工绝而未显名。","contextStatus":"needs-context"},{"start":652,"end":654,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":654,"end":862,"quote":"然皆不见称于时，亦可见唐时风气，如今论治然，有守旧、开化二党，然时尚开新其党繁盛，守旧党率为所灭。盖天下世变既成，人心趋变，以变为主；则变者必胜，不变者必败，而书亦其一端也夫理无大小，因微知著一线之点有限，而线之所引，亿兆京陔而无穷，岂不然哉！故有宋之世苏米大变唐风专主意态，此开新党也；端明笃守唐法，此守旧党也而苏米盛而蔡亡，此亦开新胜守旧之证也近世邓石如包慎伯赵撝叔变六朝体，亦开新党也；阮文达决其必盛，有见夫！","role":"theory","category":"书史书体","note":"以守旧开新与时势趋变解释书风兴衰，举苏米胜蔡、邓包赵倡六朝体。","contextStatus":"complete"},{"start":862,"end":864,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":864,"end":1133,"quote":"论书不取唐碑，非独以其浅薄也，平心而论，欧、虞入唐，年已垂暮，此实六朝人也。褚、薛笔法，清虚高简，若《伊阙石龛铭》、《石淙序》、《大周封禅坛碑》，亦何所恶！良以世所盛行，欧、虞、颜、柳诸家碑，磨翻已坏，名虽尊唐，实则尊翻变之枣木耳。若欲得旧拓，动需露台数倍之金，此是藏家之珍玩，岂学子人人可得而临摹哉！况求宋拓，已若汉高之剑，孔子之履，希世罕有，况宋以上乎！然即得信本墨迹，不如古人，况六朝拓本，皆完好无恙，出土日新，略如初拓，从此入手，便与欧、虞争道，岂与终身寄唐人篱下，局促无所成哉！识者审时通变，自不以吾说为妄陈高论，好翻前人也。\n","role":"theory","category":"学书方法","note":"解释不取唐碑因磨翻损坏、旧拓罕贵，六朝新出土本便于临学；主张审时通变。","contextStatus":"complete"},{"start":1133,"end":1135,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1135,"end":1226,"quote":"自宋、明以来，皆尚唐碑，宋、元、明多师两晋，然千年以来，法唐碑者，无人名家。南北碑兴，邓顽伯、包慎伯、张廉卿即以书雄视千古，故学者适逢世变，推陈出新，业尤易成，举此为证，尤易悟也。\n","role":"theory","category":"书史书体","note":"以邓包张新书兴盛为本朝取法六朝之证，兼叙帖学师两晋。","contextStatus":"complete"},{"start":1226,"end":1228,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1228,"end":1438,"quote":"唐人名手，诚未能出欧、虞外者，今昭陵一十四种可见也。吾最爱殷令名书《裴镜民碑》，血肉丰泽；《马周》、《褚亮》二碑次之矣。餘若王知敬之《李卫公碑》、郭俨之《陆让碑》、赵模之《兰陵公主碑》、《高士廉茔兆记》、《崔敦礼碑》，体皆相近，皆清朗爽劲，与欧、虞近者也。若权怀素《平百济碑》，间架严整，一变六朝之体，已开颜、柳之先；《崔筠》、《刘遵礼》志方劲，亦开柳派者。此唐碑之沿革，学唐碑者当知之。中间韦纵《灵庆池》、《高元裕碑》","role":"theory","category":"作品评价","note":"评昭陵诸碑清朗、权怀素及墓志开颜柳结构先声，唐碑沿革下页续。","contextStatus":"needs-context"},{"start":1438,"end":1440,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1440,"end":1489,"quote":"有龙跳虎卧之气，张颠《郎官石柱题名》有廉直劲正之体，皆唐碑之可学者。必若学唐碑，從事于诸家可也。\n","role":"theory","category":"作品评价","note":"承灵庆池等书气，称张颠郎官石柱廉直劲正，列为唐碑可学者。","contextStatus":"complete"}],"candidates":[{"id":"W20236-0001","start":8,"end":256,"quote":"殷、周以前，文字新创，虽有工拙，莫可考稽。南、北朝诸家，则春秋群贤，战国诸子，当殷、周之末运，极学术之异变，九流并出，万马齐鸣，人才之奇，后世无有。自汉以后，皆度内之人，言理不深，言才不肆，进比战国，倜乎已远，不足复为辜较。书有南、北朝，隶、楷、行草，体变各极，奇伟婉丽，意态斯备，至矣！观斯止矣。至于有唐，虽设书学，士大夫讲之尤甚。然缵承陈、隋之馀，缀其遗绪之一二，不复能变，专讲结构，几若算子。截鹤续凫，整齐过甚。欧、虞、褚、薛，笔法虽未尽亡，然浇淳散朴，古意已漓；而颜、柳迭奏，澌灭尽矣！米","category":"论争辨析","note":"以诸子百家喻六朝书体竞变，批唐碑专结构整齐过甚、古意渐漓，接米芾之评处跨未准入页。","contextStatus":"needs-context"},{"id":"W20236-0002","start":258,"end":652,"quote":"洛仁碑》极似《贺若谊》。贾赝福《大云寺》亦有六朝遗意。《灵琛禅师灰身塔文》，笔画丰厚古朴，结体亦大小有趣。《郝贵造像》峻朴，是魏法。《马君起浮图》分行结字，变态无尽。\n《韦利涉造像》遒媚俊逸。《顺陵残碑》浑古有法，若《华山精享碑题名》、王绍宗《王征君临终口授铭》、《独孤仁政碑》、《张宗碑》、《敬善寺碑》、《于孝显碑》、《法藏禅师塔铭》，皆步趋隋碑，为《宁贙》、《舍利塔》、《苏慈碑》之嗣法者。至小碑中若《王仲堪墓志》，体裁峻绝；《王留墓志》，精秀无匹。《李夫人》、《贾嫔墓志》，劲折在《刘玉》、《兖公颂》之间；《常流残石》朴茂在《吕望》、《敬显儁》之间。《韦夫人志》超浑在《王偃》、《李仲璇》之间。《一切如来心真言》，神似《刁遵》。《太常寺丞张锐志》，圆劲在《刁遵》、《曹子建》之间。《张氏墓志》骨血峻秀。《张君浮图志》体峻而美。《焦璀墓志》茂密有魏风。此类甚多，皆工绝，不失六朝矩矱，","category":"作品评价","note":"承未准入页列唐小碑，以风格笔法对照六朝，认为诸碑工绝而未显名。","contextStatus":"needs-context"},{"id":"W20236-0003","start":654,"end":862,"quote":"然皆不见称于时，亦可见唐时风气，如今论治然，有守旧、开化二党，然时尚开新其党繁盛，守旧党率为所灭。盖天下世变既成，人心趋变，以变为主；则变者必胜，不变者必败，而书亦其一端也夫理无大小，因微知著一线之点有限，而线之所引，亿兆京陔而无穷，岂不然哉！故有宋之世苏米大变唐风专主意态，此开新党也；端明笃守唐法，此守旧党也而苏米盛而蔡亡，此亦开新胜守旧之证也近世邓石如包慎伯赵撝叔变六朝体，亦开新党也；阮文达决其必盛，有见夫！","category":"书史书体","note":"以守旧开新与时势趋变解释书风兴衰，举苏米胜蔡、邓包赵倡六朝体。","contextStatus":"complete"},{"id":"W20236-0004","start":864,"end":1133,"quote":"论书不取唐碑，非独以其浅薄也，平心而论，欧、虞入唐，年已垂暮，此实六朝人也。褚、薛笔法，清虚高简，若《伊阙石龛铭》、《石淙序》、《大周封禅坛碑》，亦何所恶！良以世所盛行，欧、虞、颜、柳诸家碑，磨翻已坏，名虽尊唐，实则尊翻变之枣木耳。若欲得旧拓，动需露台数倍之金，此是藏家之珍玩，岂学子人人可得而临摹哉！况求宋拓，已若汉高之剑，孔子之履，希世罕有，况宋以上乎！然即得信本墨迹，不如古人，况六朝拓本，皆完好无恙，出土日新，略如初拓，从此入手，便与欧、虞争道，岂与终身寄唐人篱下，局促无所成哉！识者审时通变，自不以吾说为妄陈高论，好翻前人也。\n","category":"学书方法","note":"解释不取唐碑因磨翻损坏、旧拓罕贵，六朝新出土本便于临学；主张审时通变。","contextStatus":"complete"},{"id":"W20236-0005","start":1135,"end":1226,"quote":"自宋、明以来，皆尚唐碑，宋、元、明多师两晋，然千年以来，法唐碑者，无人名家。南北碑兴，邓顽伯、包慎伯、张廉卿即以书雄视千古，故学者适逢世变，推陈出新，业尤易成，举此为证，尤易悟也。\n","category":"书史书体","note":"以邓包张新书兴盛为本朝取法六朝之证，兼叙帖学师两晋。","contextStatus":"complete"},{"id"