442]],"legacySource":{"kind":"human-txt","page":574,"part":3,"label":"人工审核原TXT","verifiedBy":"宋品宣","verifiedAt":"2026-10-15T07:44:24.453Z","revision":"4debf9a41e69e17dab24b25904e7ca129d3d18c3d3c783f73cf5d593e75d6e33","textSha256":"4debf9a41e69e17dab24b25904e7ca129d3d18c3d3c783f73cf5d593e75d6e33","fileSha256":"337dfa6c51e668ea709348ab712a3393735bf97aa642fd0d59f41a894d9ef262","txtPath":"tasks/2026-10-18-part3-feedback-review/member-input/第3份-逐页校勘 (1).txt","reviewCsvPath":"tasks/2026-10-18-part3-feedback-review/member-input/第3份-TXT校验表 (1).csv"}}]},"segments":[{"start":0,"end":3,"quote":"笪重光","role":"structure","category":"结构信息","note":"作者标题：笪重光","contextStatus":"complete"},{"start":3,"end":5,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":5,"end":6,"quote":"\n","role":"structure","category":"结构信息","note":"原空格或换行。","contextStatus":"complete"},{"start":6,"end":8,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":8,"end":92,"quote":"笔的执使在横画，字之立体在竖画；气之舒展在撇捺，筋之融结在纽转；脉络之不断在丝牵，骨肉之调停在饱满；趣之呈露在勾点，光之通明在分布；行间之茂密在流贯，形势之错落在奇正。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":92,"end":94,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":94,"end":172,"quote":"横画之发笔仰，竖画之发笔俯；撇之发笔重，捺之发笔轻；折之发笔顿，裹之发笔圆；点之发笔挫，钩之发笔利；一呼之发笔露，一应之发笔藏；分布之发笔宽，结构之发笔紧。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":172,"end":174,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":174,"end":213,"quote":"数画之转接欲折，一画之自转贵圆。同一转也，若误用之必有病，分别行之，则合法耳。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":213,"end":215,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":215,"end":251,"quote":"横之住锋或收或出，竖之住锋或缩或垂，撇之出锋或掣或卷，捺之出锋或回或放。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":251,"end":253,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":253,"end":319,"quote":"人知起笔藏锋之未易，不知收笔出锋之甚难。深于八分章草者始得之。法在用笔之合势，不关手腕之强弱也。匡廓之白手布均齐，散乱之白眼布匀称。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":319,"end":321,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":321,"end":375,"quote":"画能如金刀之割净，白始如玉尺之量齐。精美出于挥毫，巧妙在于布白。体度之变化由此而分，观锺、王楷法殊势而知之。","role":"theory","category":"结体章法","note":"论大小、布白、呼应及字行形势；部分兼用笔。","contextStatus":"complete"},{"start":375,"end":377,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":377,"end":430,"quote":"真行、大小、离合、正侧章法之变，格方而棱圆，栋直而纲曲，佳构也。人知直画之力劲，而不知游丝之力更坚利多锋。","role":"theory","category":"结体章法","note":"论大小、布白、呼应及字行形势；部分兼用笔。","contextStatus":"complete"},{"start":430,"end":432,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":432,"end":468,"quote":"磨墨欲熟，破水用之则活。蘸笔欲润，蹙毫用之则浊。黑圆而白方，架宽而丝紧。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":468,"end":470,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":470,"end":516,"quote":"古今书家同一圆秀，然惟中锋劲而直，齐而润然后圆。圆斯秀矣。劲拔而绵和，圆齐而光泽，难哉难哉！","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":516,"end":518,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":518,"end":604,"quote":"将欲顺之，必故逆之。将欲落之，必故起之。将欲转之，必故折之。将欲掣之，必故顿之。将欲伸之，必故屈之。将欲拔之，必故擫之。将欲束之，必故拓之。将欲行之，必故停之。书亦逆数焉。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":604,"end":606,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":606,"end":674,"quote":"卧腕侧管，有碍中锋；伫思停机，多成算子。活泼不呆者其致豁，流通不滞者其机圆。机致相生，变化乃出。一字千字，准绳于画；十行百行，排列于直。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":674,"end":676,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":676,"end":734,"quote":"使转圆劲而秀折，分布匀豁而工巧，方许入书家之门。名手无笔笔凑泊之字，书家无字字叠成之行。黑之量度为分，白之虚净为布。","role":"theory","category":"结体章法","note":"论大小、布白、呼应及字行形势；部分兼用笔。","contextStatus":"complete"},{"start":734,"end":736,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":736,"end":811,"quote":"横不能平，竖不能直；腕不能展，目不能注：分布终不能工。分布不工，规矩终不能圆备。规矩有亏，难云法书矣。起笔为呼，承笔为应。或呼疾而应迟，或呼缓而应速。","role":"theory","category":"结体章法","note":"论大小、布白、呼应及字行形势；部分兼用笔。","contextStatus":"complete"},{"start":811,"end":813,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":813,"end":833,"quote":"横撇多削，竖撇多肥，卧捺多留，立捺多放。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":833,"end":835,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":835,"end":921,"quote":"骨体筋而植立，筋附骨而萦旋。骨有修短，筋有肥细，二者未始相离，作用因而分属。勿谓绵软二字为劣，如掣笔非第一品紫毫不能绵软也。欲知多力，观其使运中途；何谓丰筋，查其纽络一路。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":921,"end":923,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":923,"end":951,"quote":"筋骨不生于笔而笔能损之益之，血肉不生于墨而墨能增之减之。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":951,"end":953,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":953,"end":1031,"quote":"能运中锋，虽败笔亦圆。不会中锋，即佳颖亦劣。优劣之根，断在于此。肉托毫颖而腴，筋借墨沈而润。腴则多媚，润则多姿。以上论书，言浅而旨确，非工力深者不解其难也。","role":"theory","category":"用笔技法","note":"论行笔、锋势、筋骨或笔墨运用，部分兼结体布白。","contextStatus":"complete"},{"start":1031,"end":1033,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1033,"end":1135,"quote":"笪重光（一六二三年—一六九二年），情清书画家。字在辛，号江上外史，亦称郁冈扫叶道人。江苏句容人，一说丹徒人。顺治进士，官御史，巡按江南，与明珠忤，罢归。工书画，诗亦清刚隽永，如其人。著有《画筌》《书筏》。","role":"biography","category":"背景生平","note":"编者撰笪重光生平、官职与著作。","contextStatus":"complete"},{"start":1135,"end":1137,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1137,"end":1138,"quote":"\n","role":"structure","category":"结构信息","note":"原空格或换行。","contextStatus":"complete"},{"start":1138,"end":1140,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1140,"end":1320,"quote":"《书筏》一卷，原题清笪重光撰。张氏辑《昭代丛书》本后，有杨复吉跋，云梦楼所临法帖，卷首标笪江上先生论书，未言其为《书筏》，且云其全与阙不可知，其为《书筏》原本与否，亦不可知。编中所言书法，凡二十有九则，甚为精到，似非江上不办，然疑非《书筏》全文。后有王文治跋日：「此卷为笪书中无上妙品，其论书深入三昧处，直与孙虔礼先后并传，《笔阵图》不足数也。」可谓推崇至极。","role":"editorial","category":"编者题解","note":"编者讨论书筏传本、篇幅与真伪，并引王文治推崇之跋；整段为题解材料。","contextStatus":"complete"},{"start":1320,"end":1322,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1322,"end":1323,"quote":"\n","role":"structure","category":"结构信息","note":"原空格或换行。","contextStatus":"complete"},{"start":1323,"end":1325,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1325,"end":1326,"quote":"\n","role":"structure","category":"结构信息","note":"原空格或换行。","contextStatus":"complete"},{"start":1326,"end":1328,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1328,"end":1330,"quote":"书筏","role":"structure","category":"结构信息","note":"书名：书筏","contextStatus":"complete"},{"