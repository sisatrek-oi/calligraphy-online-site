-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":5,"quote":"可宗也。\n","role":"theory","category":"学书方法","note":"承未准入前页可宗之论残句。","contextStatus":"needs-context"},{"start":5,"end":7,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":7,"end":241,"quote":"魏碑无不佳者，虽穷乡儿女造像，而骨血峻宕，拙厚中皆有异态，构字亦紧密非常，岂与晋世皆当书之会邪，何其工也？譬江、汉游女之风诗，汉、魏儿童之谣谚，自能蕴蓄古雅，有后世学士所不能为者，故能择魏世造像记学之，已自能书矣。\n言造像记之可师，极言魏碑无不可学耳。魏书自有堂堂大碑，通古今，极正变，其详备于《碑品》，今择其与南碑最工者条出之。昔朱子与汪尚书论古文，汪玉山问朱子曰：「子之主人翁是谁？」对以曾南丰。曰：「子之主人翁甚体面。」今举诸家，听人择以为主人翁，亦甚体面矣。\n","role":"theory","category":"学书方法","note":"论魏造像虽穷乡儿女亦古雅紧密，选择魏碑为学书主人翁。","contextStatus":"complete"},{"start":241,"end":243,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":243,"end":405,"quote":"《爨龙颜》为雄强茂美之宗，《灵庙碑阴》辅之。\n《石门铭》为飞逸浑穆之宗，《郑文公》、《瘗鹤铭》辅之。\n《吊比干文》为瘦硬峻拔之宗，《隽修罗》、《灵塔铭》辅之。\n右三宗上\n《张猛龙》为正体变态之宗，《贾思伯》、《杨翬》辅之。\n《始兴王碑》为峻美严整之宗，《李仲璇》辅之。\n《敬显儁》为静穆茂密之宗，《朱君山》、《龙藏寺》辅之。","role":"theory","category":"作品评价","note":"列爨龙颜、石门铭、吊比干为三宗上及辅碑，续张猛龙始兴敬显等宗，按风格为取法准则。","contextStatus":"complete"},{"start":405,"end":407,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":407,"end":618,"quote":"《晖福寺》为丰厚茂密之宗，《穆子容》、《梁石阙》、《温泉颂》辅之。\n右四宗中\n《张玄》为质峻偏宕之宗，《马鸣寺》辅之。\n《高植》为浑劲质拙之宗，《王偃》、《王僧》、《臧质》辅之。\n《李超》为体骨峻美之宗，《解伯达》、《皇甫驎》辅之。\n《杨大眼》为峻健丰伟之宗，《魏灵藏》、《广川王》、《曹子建》辅之。\n《刁遵》为虚和圆静之宗，《高湛》、《刘懿》辅之。\n《吴平忠侯神道》为平整匀净之宗，《苏慈》、《舍利塔》辅之。\n右六宗下\n","role":"theory","category":"作品评价","note":"续晖福等四宗中、张玄至吴平六宗下及各辅碑，按笔法结体风格分类。","contextStatus":"complete"},{"start":618,"end":620,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":620,"end":711,"quote":"既立宗矣，其一切碑相近者各以此判之自此观碑，是非自见自此论书，亦不至聚讼纷纷矣。\n凡所立之宗，奇古者不录，靡弱者不录，怪异者不录。立其所谓备众美，通古今，极正变，足为书家极则者耳。\n","role":"theory","category":"学书方法","note":"说明依宗论碑可定是非；宗须备美通古今极正变，排除偏奇靡弱怪异。","contextStatus":"complete"},{"start":711,"end":713,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":713,"end":756,"quote":"《经石峪》为榜书之宗，《白驹谷》辅之。\n《石鼓》为篆之宗，《琅琊台》、《开母庙》辅之。","role":"theory","category":"作品评价","note":"另立榜书经石峪、篆书石鼓及其辅碑。","contextStatus":"complete"},{"start":756,"end":758,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":758,"end":822,"quote":"《三公山》为西汉分书之宗，《裴岑》、《郁阁》、《天发神谶》辅之。\n右外宗三\n汉分亦各体备有，亦各有宗，别详《本汉篇》，此不录。\n","role":"theory","category":"作品评价","note":"列三公山为西汉分宗及辅碑，交代其余分书宗派详本汉篇。","contextStatus":"complete"}],"candidates":[{"id":"W20240-0001","start":0,"end":5,"quote":"可宗也。\n","category":"学书方法","note":"承未准入前页可宗之论残句。","contextStatus":"needs-context"},{"id":"W20240-0002","start":7,"end":241,"quote":"魏碑无不佳者，虽穷乡儿女造像，而骨血峻宕，拙厚中皆有异态，构字亦紧密非常，岂与晋世皆当书之会邪，何其工也？譬江、汉游女之风诗，汉、魏儿童之谣谚，自能蕴蓄古雅，有后世学士所不能为者，故能择魏世造像记学之，已自能书矣。\n言造像记之可师，极言魏碑无不可学耳。魏书自有堂堂大碑，通古今，极正变，其详备于《碑品》，今择其与南碑最工者条出之。昔朱子与汪尚书论古文，汪玉山问朱子曰：「子之主人翁是谁？」对以曾南丰。曰：「子之主人翁甚体面。」今举诸家，听人择以为主人翁，亦甚体面矣。\n","category":"学书方法","note":"论魏造像虽穷乡儿女亦古雅紧密，选择魏碑为学书主人翁。","contextStatus":"complete"},{"id":"W20240-0003","start":243,"end":405,"quote":"《爨龙颜》为雄强茂美之宗，《灵庙碑阴》辅之。\n《石门铭》为飞逸浑穆之宗，《郑文公》、《瘗鹤铭》辅之。\n《吊比干文》为瘦硬峻拔之宗，《隽修罗》、《灵塔铭》辅之。\n右三宗上\n《张猛龙》为正体变态之宗，《贾思伯》、《杨翬》辅之。\n《始兴王碑》为峻美严整之宗，《李仲璇》辅之。\n《敬显儁》为静穆茂密之宗，《朱君山》、《龙藏寺》辅之。","category":"作品评价","note":"列爨龙颜、石门铭、吊比干为三宗上及辅碑，续张猛龙始兴敬显等宗，按风格为取法准则。","contextStatus":"complete"},{"id":"W20240-0004","start":407,"end":618,"quote":"《晖福寺》为丰厚茂密之宗，《穆子容》、《梁石阙》、《温泉颂》辅之。\n右四宗中\n《张玄》为质峻偏宕之宗，《马鸣寺》辅之。\n《高植》为浑劲质拙之宗，《王偃》、《王僧》、《臧质》辅之。\n《李超》为体骨峻美之宗，《解伯达》、《皇甫驎》辅之。\n《杨大眼》为峻健丰伟之宗，《魏灵藏》、《广川王》、《曹子建》辅之。\n《刁遵》为虚和圆静之宗，《高湛》、《刘懿》辅之。\n《吴平忠侯神道》为平整匀净之宗，《苏慈》、《舍利塔》辅之。\n右六宗下\n","category":"作品评价","note":"续晖福等四宗中、张玄至吴平六宗下及各辅碑，按笔法结体风格分类。","contextStatus":"complete"},{"id":"W20240-0005","start":620,"end":711,"quote"