er-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}},{"start":986,"end":1066,"sourceTextSha256":"2c4d3eccb7da3d2fa7af82229a8ee382c27c93fd1cf3f367d5efb921dc2e1102","id":"local-856-557-650","page_id":856,"origin":"legacy-reviewed-txt","rawStart":557,"rawEnd":650,"reviewedTextSha256":"7267f7e36814adf3f64745a6a21221d3481e61a857579d7da0a3d10dec618e95","displayUnitOrigins":[[563,564],[564,565],[565,566],[566,567],[567,568],[568,569],[569,570],[570,571],[571,572],[572,573],[573,574],[574,575],[575,576],[576,577],[577,578],[578,579],[579,580],[580,581],[581,582],[582,583],[583,584],[584,585],[585,586],[586,587],[587,588],[588,589],[589,590],[590,591],[591,592],[592,593],[593,594],[594,595],[595,596],[596,597],[597,598],[598,599],[599,600],[600,601],[608,609],[609,610],[610,611],[611,612],[612,613],[613,614],[614,615],[615,616],[616,617],[617,618],[618,619],[619,620],[620,621],[621,622],[622,623],[623,624],[624,625],[625,626],[626,627],[627,628],[628,629],[629,630],[630,631],[631,632],[632,633],[633,634],[634,635],[635,636],[636,637],[637,638],[638,639],[639,640],[640,641],[641,642],[642,643],[643,644],[644,645],[645,646],[646,647],[647,648],[648,649],[649,650]],"legacySource":{"kind":"human-txt","page":856,"part":4,"label":"人工审核原TXT","verifiedBy":"帅睿","verifiedAt":"2026-10-21T11:39:36.358Z","revision":"7267f7e36814adf3f64745a6a21221d3481e61a857579d7da0a3d10dec618e95","textSha256":"7267f7e36814adf3f64745a6a21221d3481e61a857579d7da0a3d10dec618e95","fileSha256":"1185f1a3fa26a44f344bcc8de1c99f9576cacd75c8b6baf2d2fd9087b7e29e57","txtPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":7,"quote":"缀法第二十一\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":7,"end":9,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":9,"end":277,"quote":"书法之妙，全在运笔。该举其要，尽于方圆。操纵极熟，自有巧妙，方用顿笔，圆用提笔。提笔中含，顿笔外拓。中含者浑劲，外拓者雄强，中含者篆之法也，外拓者隶之法也。\n提笔婉而通，顿笔精而密，圆笔者萧散超逸，方笔者凝整沉著。提则筋劲，顿则血融，圆则用抽，方则用絜。圆笔使转用提，而以顿挫出之。方笔使转用顿，而以提絜出之。圆笔用绞，方笔用翻，圆笔不绞则痿，方笔不翻则滞。圆笔出以险，则得劲。方笔出以颇，则得骏。\n提笔如游丝袅空，顿笔如狮狻蹲地。妙处在方圆并用，不方不圆，亦方亦圆，或体方而用圆，或用方而体圆，或笔方而章法圆，神而明之，存乎其人矣。\n","role":"theory","category":"用笔技法","note":"运笔要在方圆，分顿提、外拓中含、绞翻并论方圆交用，强调体笔章法互变。","contextStatus":"complete"},{"start":277,"end":279,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":279,"end":511,"quote":"求之古碑，《杨大眼》、《魏灵藏》、《始平公》、《郑长猷》、《灵感》、《张猛龙》、《始兴王》、《隽修罗》、《高贞》等碑，方笔也。《石门铭》、《郑文公》、《瘗鹤铭》、《刁遵》、《高湛》、《敬显儁》、《龙藏寺》等碑，圆笔也。《爨龙颜》、《李超》、《李仲璇》、《解伯达》等碑，方圆并用之笔也。方圆之分，虽云导源篆隶，然正书波磔，全出汉分。汉分中实备方圆，如《褒斜》、《郙阁》、《孔谦》、《尹宙》、《东海庙》、《曹全》、《石经》，皆圆笔也。《衡方》、《张迁》、《白石神君》、","role":"theory","category":"作品评价","note":"列方笔圆笔方圆并用诸碑为范例，并追溯汉分方圆笔法，名单下页续。","contextStatus":"needs-context"},{"start":511,"end":513,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":513,"end":735,"quote":"《上尊号》、《受禅》，皆方笔也。盖方笔便于作正书，圆笔便于作行草。然此言其大较，正书无圆笔，则无宕逸之致，行草无方笔，则无雄强之神，则又交相为用也。\n以腕力作书便于作圆笔，以作方笔，似稍费力，而尤有矫变飞动之气，便于自运，而亦可临仿，便于行草，而尤工分楷。以指力作书便于作方笔不能作圆笔，便于临仿，而难于自运，可以作分楷，不能作行草，可以临欧、柳，不能临《郑文公》、《瘞鹤铭》也。故欲运笔，必先能运腕，而后能方能圆也。然学之始，又宜先方笔也。\n","role":"theory","category":"用笔技法","note":"承汉分方笔，论正行草互用方圆，以腕力兼能方圆，学初宜先方。","contextStatus":"complete"},{"start":735,"end":737,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":737,"end":984,"quote":"古人笔法至多，然学者不经师授，鲜能用之。但多见碑刻，多临细验，自有所得。善乎张长史告裴儆曰：「倍加工学，临写书法，当自悟耳。」可见昔人亦无奇特秘诀也。即其告鲁公，亦曰：「执笔圆畅，布置合宜，纸笔精佳，变通适怀。」此数语至庸，而书道之精，诚不外此。若言简而该，有李华之说曰：「用笔在乎虚掌而实指，缓衄而急送，意在笔前，字居笔后，不拙不巧，不今不古，华质相半。」又曰：「有二字神诀，截也，拽也。」所谓截、拽者，谓未可截者截之，可以已者拽之。后有山谷殆得此诀以名家者也。窦息论书七千馀字，甚精可玩。\n","role":"theory","category":"学书方法","note":"多见碑刻多临细验自悟，引张旭告裴儆鲁公及李华虚掌实指、意在笔前，反对奇秘化。","contextStatus":"complete"},{"start":984,"end":986,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":986,"end":1066,"quote":"黄小仲论书，以章法为主，在牝牡相得，不计点画工拙。包慎伯因为大九宫之论，然古人实已有之。张怀瓘曰：「偃仰向背，阴阳相应，鳞羽参差，峰峦起伏，迟涩飞动，射空玲珑，","role":"theory","category":"结体章法","note":"黄小仲章法牝牡相得、包世臣大九宫及张怀瓘偃仰向背之说；末引语遇未准入页。","contextStatus":"needs-context"}],"candidates":[{"id":"W20245-0001","start":9,"end":277,"quote":"书法之妙，全在运笔。该举其要，尽于方圆。操纵极熟，自有巧妙，方用顿笔，圆用提笔。提笔中含，顿笔外拓。中含者浑劲，外拓者雄强，中含者篆之法也，外拓者隶之法也。\n提笔婉而通，顿笔精而密，圆笔者萧散超逸，方笔者凝整沉著。提则筋劲，顿则血融，圆则用抽，方则用絜。圆笔使转用提，而以顿挫出之。方笔使转用顿，而以提絜出之。圆笔用绞，方笔用翻，圆笔不绞则痿，方笔不翻则滞。圆笔出以险，则得劲。方笔出以颇，则得骏。\n提笔如游丝袅空，顿笔如狮狻蹲地。妙处在方圆并用，不方不圆，亦方亦圆，或体方而用圆，或用方而体圆，或笔方而章法圆，神而明之，存乎其人矣。\n","category":"用笔技法","note":"运笔要在方圆，分顿提、外拓中含、绞翻并论方圆交用，强调体笔章法互变。","contextStatus":"complete"},{"id":"W20245-0002","start":279,"end":511,"quote":"求之古碑，《杨大眼》、《魏灵藏》、《始平公》、《郑长猷》、《灵感》、《张猛龙》、《始兴王》、《隽修罗》、《高贞》等碑，方笔也。《石门铭》、《郑文公》、《瘗鹤铭》、《刁遵》、《高湛》、《敬显儁》、《龙藏寺》等碑，圆笔也。《爨龙颜》、《李超》、《李仲璇》、《解伯达》等碑，方圆并用之笔也。方圆之分，虽云导源篆隶，然正书波磔，全出汉分。汉分中实备方圆，如《褒斜》、《郙阁》、《孔谦》、《尹宙》、《东海庙》、《曹全》、《石经》，皆圆笔也。《衡方》、《张迁》、《白石神君》、","category":"作品评价","note":"列方笔圆笔方圆并用诸碑为范例，并追溯汉分方圆笔法，名单下页续。","contextStatus":"needs-context"},{"id":"W20245-0003","start":513,"end":735,"quote":"《上尊号》、《受禅》，皆方笔也。盖方笔便于作正书，圆笔便于作行草。然此言其大较，正书无圆笔，则无宕逸之致，行草无方笔，则无雄强之神，则又交相为用也。\n以腕力作书便于作圆笔，以作方笔，似稍费力，而尤有矫变飞动之气，便于自运，而亦可临仿，便于行草，而尤工分楷。以指力作书便于作方笔不能作圆笔，便于临仿，而难于自运，可以作分楷，不能作行草，可以临欧、柳，不能临《郑文公》、《瘞鹤铭》也。故欲运笔，必先能运腕，而后能方能圆也。然学之始，又宜先方笔也。\n","category":"用笔技法","note":"承汉分方笔，论正行草互用方圆，以腕力兼能方圆，学初宜先方。","contextStatus":"complete"},{"id":"W20245-0004","start":737,"end":984,"quote":"古人笔法至多，然学者不经师授，鲜能用之。但多见碑刻，多临细验，自有所得。善乎张长史告裴儆曰：「倍加工学，临写书法，当自悟耳。」可见昔人亦无奇特秘诀也。即其告鲁公，亦曰：「执笔圆畅，布置合宜，纸笔精佳，变通适怀。」此数语至庸，而书道之精，诚不外此。若言简而该，有李华之说曰：「用笔在乎虚掌而实指，缓衄而急送，意在笔前，字居笔后，不拙不巧，不今不古，华质相半。」又曰：「有二字神诀，截也，拽也。」所谓截、拽者，谓未