,195],[195,196],[196,197],[197,198],[198,199],[199,200],[200,201],[201,202],[202,203],[203,204],[204,205],[205,206],[206,207],[207,208],[208,209],[209,210],[210,211],[211,212],[212,213],[213,214],[214,215],[215,216],[216,217],[217,218],[218,219],[219,220],[220,221],[221,222],[222,223],[223,224],[224,225],[225,226],[226,227],[227,228],[228,229],[229,230],[230,231],[231,232],[239,240],[240,241],[241,242],[242,243],[243,244],[244,245],[245,246],[246,247],[247,248],[248,249],[249,250],[250,251],[251,252],[252,253],[253,254],[254,255],[255,256],[256,257],[257,258],[258,259],[259,260],[260,261],[261,262],[262,263],[263,264],[264,265],[265,266],[266,267],[267,268],[268,269],[269,270],[270,271],[271,272],[272,273],[273,274]],"legacySource":{"kind":"human-txt","page":824,"part":4,"label":"人工审核原TXT","verifiedBy":"帅睿","verifiedAt":"2026-10-19T12:19:24.016Z","revision":"592775d130c8da938f966f557594230e9eec627417a7cf60afd7abc642ed20a4","textSha256":"592775d130c8da938f966f557594230e9eec627417a7cf60afd7abc642ed20a4","fileSha256":"1185f1a3fa26a44f344bcc8de1c99f9576cacd75c8b6baf2d2fd9087b7e29e57","txtPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":6,"quote":"取隋第十一\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":6,"end":8,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":8,"end":221,"quote":"何朝碑不足取，何独取于隋？隋碑无绝佳者，隋人无以书名冠世者，又何足取？不知此古今之故也。吾爱古碑，莫如《谷朗》、《郛休》、《爨宝子》、《枳阳府君》、《灵庙碑》、《鞠彦云》，以其由隶变楷，足考源流也。爱精丽之碑，莫若《爨龙颜》、《灵庙碑阴》、《晖福寺》、《石门铭》、《郑文公》、《张猛龙》，以其为隶、楷之极则也。隋碑内承周、齐峻整之绪，外收梁、陈绵丽之风，故简要清通，汇成一局，淳朴未除，精能不露。譬之骈文之有彦升、休文，诗家之","role":"theory","category":"书史书体","note":"论隋碑承周齐峻整、梁陈绵丽而简要清通、淳朴精能，篇首设问答。","contextStatus":"needs-context"},{"start":221,"end":223,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":223,"end":235,"quote":"碑真足当古今之变者矣。\n","role":"theory","category":"作品评价","note":"承未准入前页对碑体变革之评，句首待文。","contextStatus":"needs-context"},{"start":235,"end":237,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":237,"end":543,"quote":"《苏慈碑》以光绪十三年出土，初入人间，辄得盛名。以其端整妍美，足为干禄之资，而笔画完好，较屡翻之欧碑易学。于是翰林之写白摺者，举子之写大卷者，人购一本，期月而纸贵洛阳，信哉其足取也！然气势薄弱，行间亦无雄强茂密之象。沈刑部子培以为赝作，或者以时人能书者比之，未能迫切，无从作赝。子培曰：「笔法不易赝古，刀法赝古最易，厂肆优为之。」黄编修仲弢以其中叙葬处乐邑里数字，行气不接，字体不类，为后来填上；若贋作必手笔一律，因尊信之。吾观梁《吴平忠侯》、贞观时《于孝显碑》，匀净相近，盖梁、隋间有是书体。学者好古从长，临写有益，中原采菽，无事苛求，信以传信可也。《姚辨志》虽为率更书，以石本不传，仅有宋人翻本，故不叙焉。\n","role":"theory","category":"论争辨析","note":"记苏慈出土与科举风尚，区分沈子培疑赝、黄仲弢反证及作者临写有益的结论。","contextStatus":"complete"},{"start":543,"end":545,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":545,"end":772,"quote":"《舍利塔》运笔爽达，结体雍容茂密，而有疏朗之致，诚为《醴泉》之先声，上可学古，下可干禄，莫若是碑。《龙华寺》气体相似，但稍次矣。《贺若谊》峻整略同，雍容不及，然亦致佳者也。《赵芬残石》字小数分，甚茂重，与魏碑《惠辅造像》同，字小而体画密厚。可见古人用笔必丰毫铺纸上岂若《温大雅碑》之薄弱乎！\n唐人深于隋碑，得洞达之意者，有《裴镜民》《灵庆池》二碑，清丰端美，笔画亦完好，当为佳本。《裴镜民》匀粹秀整，态度安和；《灵庆池》则有腾掷之势，略见龙跳虎卧气象，尤","role":"theory","category":"作品评价","note":"评舍利塔龙华贺若谊赵芬及裴镜民灵庆池的运笔、结体、丰毫与气象，末句下续。","contextStatus":"needs-context"},{"start":772,"end":774,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":774,"end":1008,"quote":"为妙品。《九成》、《皇甫》，佳拓不可得，得二碑可代兴矣。\n《臧质》古厚而宽博，犹有《龙颜》、《晖福》遗风。《宁赞》严密而峻拔，犹是《修罗》、《定国》馀派。《龙山公》为虞、颜先声，《钦江谏议》为率更前导，其与《龙藏》，皆为隋世鼎足佳碑也。书至于隋、齐、周，名手若赵文深、李德林；梁、陈隽彦，若王褒、庾信，咸集长安，故善书尤众。永叔跋《丁道护碑》曰：「隋之晚年，书家尤盛，吾家率更与虞世南，皆当时人。余所集录开皇、仁寿、大业时碑颇多，其笔画率皆精劲。」盖隋碑之足赏久矣。\n","role":"theory","category":"作品评价","note":"承裴镜民灵庆池妙品，列臧质宁赞等碑并引欧阳修赞隋末书盛。","contextStatus":"complete"}],"candidates":[{"id":"W20235-0001","start":8,"end":221,"quote":"何朝碑不足取，何独取于隋？隋碑无绝佳者，隋人无以书名冠世者，又何足取？不知此古今之故也。吾爱古碑，莫如《谷朗》、《郛休》、《爨宝子》、《枳阳府君》、《灵庙碑》、《鞠彦云》，以其由隶变楷，足考源流也。爱精丽之碑，莫若《爨龙颜》、《灵庙碑阴》、《晖福寺》、《石门铭》、《郑文公》、《张猛龙》，以其为隶、楷之极则也。隋碑内承周、齐峻整之绪，外收梁、陈绵丽之风，故简要清通，汇成一局，淳朴未除，精能不露。譬之骈文之有彦升、休文，诗家之","category":"书史书体","note":"论隋碑承周齐峻整、梁陈绵丽而简要清通、淳朴精能，篇首设问答。","contextStatus":"needs-context"},{"id":"W20235-0002","start":223,"end":235,"quote":"碑真足当古今之变者矣。\n","category":"作品评价","note":"承未准入前页对碑体变革之评，句首待文。","contextStatus":"needs-context"},{"id":"W20235-0003","start":237,"end":543,"quote":"《苏慈碑》以光绪十三年出土，初入人间，辄得盛名。以其端整妍美，足为干禄之资，而笔画完好，较屡翻之欧碑易学。于是翰林之写白摺者，举子之写大卷者，人购一本，期月而纸贵洛阳，信哉其足取也！然气势薄弱，行间亦无雄强茂密之象。沈刑部子培以为赝作，或者以时人能书者比之，未能迫切，无从作赝。子培曰：「笔法不易赝古，刀法赝古最易，厂肆优为之。」黄编修仲弢以其中叙葬处乐邑里数字，行气不接，字体不类，为后来填上；若贋作必手笔一律，因尊信之。吾观梁《吴平忠侯》、贞观时《于孝显碑》，匀净相近，盖梁、隋间有是书体。学者好古从长，临写有益，中原采菽，无事苛求，信以传信可也。《姚辨志》虽为率更书，以石本不传，仅有宋人翻本，故不叙焉。\n","category":"论争辨析","note":"记苏慈出土与科举风尚，区分沈子培疑赝、黄仲弢反证及作者临写有益的结论。","contextStatus":"complete"},{"id":"W20235-0004","start":545,"end":772,"quote":"《舍利塔》运笔爽达，结体雍容茂密，而有疏朗之致，诚为《醴泉》之先声，上可学古，下可干禄，莫若是碑。《龙华寺》气体相似，但稍次矣。《贺若谊》峻整略同，雍容不及，然亦致佳者也。《赵芬残石》字小数分，甚茂重，与魏碑《惠辅造像》同，字小而体画密厚。可见古人用笔必丰毫铺纸上岂若《温大雅碑》之薄弱乎！\n唐人深于隋碑，得洞达之意者，有《裴镜民》《灵庆池》二碑，清丰端美，笔画亦完好，当为佳本。《裴镜民》匀粹秀整，态度安和；《灵庆池》则有腾掷之势，略见龙跳虎卧气象，尤","category":"作品评价","note":"评舍利塔龙华贺若谊赵芬及裴镜民灵庆池的运笔、结体、丰毫与气象，末句下续。","contextStatus":"needs-context"},{"id":"W20235-0005","start":774,"end":1008,"quote":"为妙品。《九成》、《皇甫》，佳拓不可得，得二碑可代兴矣。\n《臧质》古厚而宽博，犹有《龙颜》、《晖福》遗风。《宁赞》严密而峻拔，犹是《修罗》、《定国》馀派。《龙山公》为虞、颜先声，《钦江谏议》为率更前导，其与《龙藏》，皆为隋世鼎足佳碑也。书至于隋、齐、周，名手若赵文深、李德林；梁、陈隽彦，若王褒、庾信，咸集长安，故善书尤众。永叔跋《丁道护碑》曰：「隋之晚年，书家尤盛，吾家率更与虞世南，皆当时人。余所集录开皇、仁寿、大业时碑颇多，其笔画率皆精劲。」盖隋碑之足赏久矣。\n","category":"作品评价","note":"承裴镜民灵庆池妙品，列臧质宁赞等碑并引欧阳修赞隋末书盛。","contextStatus":"complete"}],"contextNotes":["本章仅保留已合格人工稿，原扫描尚有缺口：822页。整章确认仅覆盖已开放正文，不代表缺文已补齐。"],"summary":"wolai优先标准；仅本地独有段落明确保留。AI初标等待整章通读。","annotationRevision":"0ad73786a1b14f7a1257a799349a8259c0396066eb49034adf907855499ef450"}