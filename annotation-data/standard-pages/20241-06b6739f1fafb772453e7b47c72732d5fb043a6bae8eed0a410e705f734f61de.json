1,"end":313,"quote":"神品","role":"structure","category":"结构信息","note":"碑品内神品等第标记；属评价列表表头，不是独立分篇。","contextStatus":"complete"},{"start":313,"end":315,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":315,"end":333,"quote":"《爨龙颜碑》《灵庙碑阴》《石门铭》\n","role":"theory","category":"作品评价","note":"承上页神品，列爨龙颜、灵庙碑阴、石门铭。","contextStatus":"complete"},{"start":333,"end":335,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":335,"end":339,"quote":"妙品上\n","role":"structure","category":"结构信息","note":"品等表头：妙品上。","contextStatus":"complete"},{"start":339,"end":341,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":341,"end":361,"quote":"《郑文公四十二种》《晖福寺》《梁石阙》\n","role":"theory","category":"作品评价","note":"妙品上列郑文公四十二种、晖福寺、梁石阙。","contextStatus":"complete"},{"start":361,"end":363,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":363,"end":367,"quote":"妙品下\n","role":"structure","category":"结构信息","note":"品等表头：妙品下。","contextStatus":"complete"},{"start":367,"end":369,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":369,"end":426,"quote":"《枳阳府君碑》《梁绵州造像》《瘞鹤铭》《泰山经石峪》\n《般若经》\n《石井阑题字》《萧衍造像》\n《孝昌六十人造像》\n","role":"theory","category":"作品评价","note":"妙品下列枳阳府君、梁绵州造像、瘗鹤铭、经石峪、般若经等碑刻。","contextStatus":"complete"},{"start":426,"end":428,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":428,"end":432,"quote":"高品上\n","role":"structure","category":"结构信息","note":"品等表头：高品上。","contextStatus":"complete"},{"start":432,"end":434,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":434,"end":461,"quote":"《谷朗碑》\n《葛祚碑额》\n《吊比干文》《嵩高灵庙碑》\n","role":"theory","category":"作品评价","note":"高品上列谷朗、葛祚碑额、吊比干、嵩高灵庙。","contextStatu