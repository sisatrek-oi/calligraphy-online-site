3],[543,544],[544,545],[545,546],[546,547],[547,548],[548,549],[549,550],[550,551],[551,552],[552,553],[553,554],[554,555],[555,556],[556,557],[557,558],[558,559],[559,560],[560,561],[561,562],[562,563],[563,564],[564,565],[565,566],[566,567],[567,568],[568,569],[569,570],[570,571],[571,572],[572,573],[573,574],[574,575],[575,576],[576,577],[577,578],[578,579],[579,580],[580,581],[581,582],[582,583],[583,584],[584,585],[585,586],[586,587],[587,588],[588,589],[589,590],[590,591],[591,592],[592,593],[593,594],[594,595],[595,596],[596,597],[597,598],[598,599],[599,600],[600,601],[601,602],[602,603],[603,604],[604,605],[605,606],[606,607],[607,608],[608,609],[609,610],[610,611],[611,612]],"legacySource":{"kind":"human-txt","page":640,"part":3,"label":"人工审核原TXT","verifiedBy":"宋品宣","verifiedAt":"2026-10-20T09:29:38.736Z","revision":"23684403f37ea94bf1d4cb30b2e3268e1381ce47a44bc0d9c1f21e6ebac91ff4","textSha256":"23684403f37ea94bf1d4cb30b2e3268e1381ce47a44bc0d9c1f21e6ebac91ff4","fileSha256":"5e3a8e126438f8956a4f6192ae403b5c724c1b67665b9c18af94841661f1f0de","txtPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-3-part-3/第3份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-3-part-3/第3份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-3-part-3/第3份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":3,"quote":"总论\n","role":"structure","category":"结构信息","note":"原分篇题。","contextStatus":"complete"},{"start":3,"end":5,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":5,"end":85,"quote":"余尝论工画者不善山水，不能称画家；工书者不精小楷，不能称书家。书画虽小道，其理则一。昔人谓右军《乐毅论》为千古楷法之祖，其言确有理据。盖《黄庭》、《曹娥》、《像","role":"theory","category":"作品评价","note":"论小楷为书家必备，并以《乐毅论》为楷法之祖；举帖续页。","contextStatus":"needs-context"},{"start":85,"end":87,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":87,"end":157,"quote":"赞》非不妙，然各立面目，惟《乐毅》冲融大雅，方圆适中，实开后世馆阁试策之端，斯为上乘。如唐之虞、褚，元之赵，明之文、祝，皆能得其三昧者也。\n","role":"theory","category":"作品评价","note":"承637页比较小楷各帖，推《乐毅》冲融方圆。","contextStatus":"needs-context"},{"start":157,"end":159,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":159,"end":383,"quote":"碑榜之书与翰牍之书是两条路，本不相紊也。董思翁云：「  余以《黄庭》、《乐毅》真书放大，为人作榜署书，每悬看辄不佳。」思翁不知碑、帖是两条路，而以翰牍为碑榜者，那得佳乎！古来书碑者，在汉、魏必以隶书，在晋、宋六朝必以真书，以行书而书碑者，始于唐太宗之《晋祠铭》，李北海继之。北宋之碑尚真行参半，迨米南宫父子一开风气，至南朝，告敕碑碣则全用行书矣。总之，长笺短幅，挥洒自如，非行书、草书不足以尽其妙，大书深刻，端庄得体，非隶书、真书不足以擅其长也。\n","role":"theory","category":"论争辨析","note":"辨碑帖两路，追叙行书入碑史并论各自功用。","contextStatus":"complete"},{"start":383,"end":385,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":385,"end":552,"quote":"思翁于宋四家中独推服米元章一人，谓自唐以后，未有过之，此所谓僧赞僧也。盖思翁天分高绝，赵吴兴尚不在眼底，况文徵仲、祝希哲辈耶！元章出笔实在苏、黄之上；惟思堪与作敌，然二公者，皆能纵而不能伏，能大而不能小，能行而不能楷者，何也？余谓皆坐天分过高之病，天分高则易于轻视古人，笔笔皆自运而出，故所书如天马行空，不受羁束，全以天分用事者也。\n","role":"theory","category":"书家评价","note":"评董米天分、纵而不能伏与大小行楷局限。","contextStatus":"complete"},{"start":552,"end":554,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":554,"end":632,"quote":"米元章、董思翁皆天资清妙，自少至老笔未尝停，尝立论临古人书不必形似，此聪明人欺世语，不可以为训也。吾人学力既浅，见闻不多，而资性又复平常，求其形似尚不能，况","role":"theory","category":"论争辨析","note":"反对临古不必形似说，指出常人资学限制；反问跨页。","contextStatus":"needs-context"},{"start":632,"end":634,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":634,"end":680,"quote":"不形似乎！譬如临《兰亭序》，全用自己戈法，亦不用原本行款，则是抄录其文耳，岂遂谓之临古乎！\n","role":"theory","category":"学书方法","note":"承638页主张临古须顾笔法行款，否则仅抄文。","contextStatus":"needs-context"},{"start":680,"end":682,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":682,"end":765,"quote":"凡应制诗文、牋奏、章疏等书，只求文词之妙，不求书法之精，只要匀称端正而已，与书家绝然相反。元章自叙云：「古人书笔笔不同，各立面目，若一一相似，排如算子，则奴书也。」\n","role":"theory","category":"结体章法","note":"区别应制匀称与书家变化，引米芾反算子奴书。","contextStatus":"complete"},{"start":765,"end":767,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":767,"end":903,"quote":"或有问余云：「凡学书毕竟以何碑何帖为佳？余曰：「不知也。」昔米元章初学颜书，嫌其宽，乃学柳，结字始紧。知柳出于欧，又学欧。久之类印板文字，弃而学褚，而学之最久。又喜李北海书，始能转折肥美，八面皆圆。再入魏晋之室，而兼乎篆隶。夫以元章之天资，尚力学如此，岂一碑一帖所能尽。\n","role":"theory","category":"学书方法","note":"以米芾转益多师反对一碑一帖尽书学。","contextStatus":"complete"},{"start":903,"end":905,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":905,"end":948,"quote":"虞道园云：「坡、谷出而魏晋之法废，米元章、黄长睿乃知古法。」虽过高之论，然其言甚确。\n","role":"theory","category":"论争辨析","note":"引虞集对苏黄米黄的魏晋古法判断，并赞其意。","contextStatus":"complete"},{"start":948,"end":950,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":950,"end":1042,"quote":"张丑云「子昂书法温润闲雅，远接右军，第过为妍媚纤柔，殊乏大节不夺之气」，非正论也。褚中令书，昔人比之美女婵娟，不胜罗绮，而其忠言谠论，直为有唐一代名臣，岂在区区笔墨间，以定其人品乎！\n","role":"theory","category":"论争辨析","note":"反对据赵妍媚定人品，以褚忠直作反证。","contextStatus":"complete"},{"start":1042,"end":1044,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1044,"end":1080,"quote":"人之身，情致蕴于内，姿媚见平外，不可无也。作书亦然。古人之书原无所谓姿媚","role":"theory","category":"审美风格","note":"以人的情致姿媚说明书可有姿媚，接640页。","contextStatus":"needs-context"},{"start":1080,"end":1082,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1082,"end":1122,"quote":"者，自右军一开风气，遂至姿媚横生，为后世行草祖法，今人有谓姿媚为大病者，非也。\n","role":"theory","category":"审美风格","note":"承639页肯定王羲之以来行草姿媚，驳以姿媚为大病。","contextStatus":"needs-context"},{"start":1122,"end":1124,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1124,"end":1316,"quote":"思翁书画俱是大作手，其画宗北苑，而兼得大，小米之长，尚在第二乘，惟书法无古无今，不名一格，而能卓然成家，盖天资高妙，直在古人上也。余尝见思一画卷，用笔淹润，秀绝人寰，后有款云：「  时年八十有一。」又见一书卷，临锺，王，虞，储，颜，柳及苏，黄诸家，后有题云：「 此数帖余临仿一生，才得十之三四，可脱去拘束之习。」书时亦年八十一。夫以思翁之天资学力，尚作书作画，老而不衰，自成大家也。\n","role":"theory","category":"书家评价","note":"评董书成家与晚年临古不辍，引其题卷自述。","contextStatus":"complete"},{"start":1316,"end":1318,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1318,"end":1662,"quote":"近日所称海内书家者，有三人焉：「一为诸城刘文清公；一为钱塘梁山舟侍讲；一为丹徒王梦楼太守也。或论文清书如枯禅入定，侍讲书如布帛菽粟，太守书如倚门卖俏。余谓此论太苛。文清本从松雪入手，灵峭异常，而误于《淳化阁帖》，遂至模棱终老，如商鼎、周彝，非不古而不适于用。侍讲早年亦宗赵、董，惟自壮至老笔笔自运，不屑依傍古人，故所书全无帖意，如旧家子弟，不过循规蹈矩，饱暖终身而已。至太守则天资清妙，本学思翁，而稍沾笪江上习气。中年得张樗寮真迹临模，遂入轻桃一路，而姿态自佳，如秋娘傅粉，骨格清纤，终不庄重耳。三公者，余俱尝亲炙，奉为圭臬，何敢妄生议论，然见文清笑侍讲为灶下老婢，侍讲亦笑文清为滕公佳城，太守笑两公，两公亦笑太守，虽文人相轻，自古而然，而谓三公必传，可与松雪、思翁争席者，则吾未敢信也。","role":"theory","category":"书家评价","note":"引刘梁王三家比喻评并分别论取法和局限，记三家互讥而不许争席赵董。","contextStatus":"complete"}],"candidates":[{"id":"W20218-0001","start":5,"end":85,"quote":"余尝论工画者不善山水，不能称画家；工书者不精小楷，不能称书家。书画虽小道，其理则一。昔人谓右军《乐毅论》为千古楷法之祖，其言确有理据。盖《黄庭》、《曹娥》、《像","category":"作品评价","note":"论小楷为书家必备，并以《乐毅论》为楷法之祖；举帖续页。","contextStatus":"needs-context"},{"id":"W20218-0002","start":87,"end":157,"quote":"赞》非不妙，然各立面目，惟《乐毅》冲融大雅，方圆适中，实开后世馆阁试策之端，斯为上乘。如唐之虞、褚，元之赵，明之文、祝，皆能得其三昧者也。\n","category":"作品评价","note":"承637页比较小楷各帖，推《乐毅》冲融方圆。","contextStatus":"needs-context"},{"id":"W20218-0003","start":159,"end":383,"quote":"碑榜之书与翰牍之书是两条路，本不相紊也。董思翁云：「  余以《黄庭》、《乐毅》真书放大，为人作榜署书，每悬看辄不佳。」思翁不知碑、帖是两条路，而以翰牍为碑榜者，那得佳乎！古来书碑者，在汉、魏必以隶书，在晋、宋六朝必以真书，以行书而书碑者，始于唐太宗之《晋祠铭》，李北海继之。北宋之碑尚真行参半，迨米南宫父子一开风气，至南朝，告敕碑碣则全用行书矣。总之，长笺短幅，挥洒自如，非行书、草书不足以尽其妙，大书深刻，端庄得体，非隶书、真书不足以擅其长也。\n","category":"论争辨析","note":"辨碑帖两路，追叙行书入碑史并论各自功用。","contextStatus":"complete"},{"id":"W20218-0004","start":385,"end":552,"quote":"思翁于宋四家中独推服米元章一人，谓自唐以后，未有过之，此所谓僧赞僧也。盖思翁天分高绝，赵吴兴尚不在眼底，况文徵仲、祝希哲辈耶！元章出笔实在苏、黄之上；惟思堪与作敌，然二公者，皆能纵而不能伏，能大而不能小，能行而不能楷者，何也？余谓皆坐天分过高之病，天分高则易于轻视古人，笔笔皆自运而出，故所书如天马行空，不受羁束，全以天分用事者也。\n","category":"书家评价","note":"评董米天分、纵而不能伏与大小行楷局限。","contextStatus":"complete"},{"id":"W20218-0005","start":554,"end":632,"quote":"米元章、董思翁皆天资清妙，自少至老笔未尝停，尝立论临古人书不必形似，此聪明人欺世语，不可以为训也。吾人学力既浅，见闻不多，而资性又复平常，求其形似尚不能，况","category":"论争辨析","note":"反对临古不必形似说，指出常人资学限制；反问跨页。","contextStatus":"needs-context"},{"id":"W20218-0006","start":634,"end":680,"quote":"不形似乎！譬如临《兰亭序》，全用自己戈法，亦不用原本行款，则是抄录其文耳，岂遂谓之临古乎！\n","category":"学书方法","note":"承638页主张临古须顾笔法行款，否则仅抄文。","contextStatus":"needs-context"},{"id":"W20218-0007","start":682,"end":765,"quote":"凡应制诗文、牋奏、章疏等书，只求文词之妙，不求书法之精，只要匀称端正而已，与书家绝然相反。元章自叙云：「古人书笔笔不同，各立面目，若一一相似，排如算子，则奴书也。」\n","category":"结体章法","note":"区别应制匀称与书家变化，引米芾反算子奴书。","contextStatus":"complete"},{"id":"W20218-0008","start":767,"end":903,"quote":"或有问余云：「凡学书毕竟以何碑何帖为佳？余曰：「不知也。」昔米元章初学颜书，嫌其宽，乃学柳，结字始紧。知柳出于欧，又学欧。久之类印板文字，弃而学褚，而学之最久。又喜李北海书，始能转折肥美，八面皆圆。再入魏晋之室，而兼乎篆隶。夫以元章之天资，尚力学如此，岂一碑一帖所能尽。\n","category":"学书方法","note":"以米芾转益多师反对一碑一帖尽书学。","contextStatus":"complete"},{"id":"W20218-0009","start":905,"end":948,"quote":"虞道园云：「坡、谷出而魏晋之法废，米元章、黄长睿乃知古法。」虽过高之论，然其言甚确。\n","category":"论争辨析","note":"引虞集对苏黄米黄的魏晋古法判断，并赞其意。","contextStatus":"complete"},{"id":"W20218-0010","start":950,"end":1042,"quote":"张丑云「子昂书法温润闲雅，远接右军，第过为妍媚纤柔，殊乏大节不夺之气」，非正论也。褚中令书，昔人比之美女婵娟，不胜罗绮，而其忠言谠论，直为有唐一代名臣，岂在区区笔墨间，以定其人品乎！\n","category":"论争辨析","note":"反对据赵妍媚定人品，以褚忠直作反证。","contextStatus":"complete"},{"id":"W20218-0011","start":1044,"end":1080,"quote":"人之身，情致蕴于内，姿媚见平外，不可无也。作书亦然。古人之书原无所谓姿媚","category":"审美风格","note":"以人的情致姿媚说明书可有姿媚，接640页。","contextStatus":"needs-context"},{"id":"W20218-0012","start":1082,"end":1122,"quote":"者，自右军一开风气，遂至姿媚横生，为后世行草祖法，今人有谓姿媚为大病者，非也。\n","category":"审美风格","note":"承639页肯定王羲之以来行草姿媚，驳以姿媚为大病。","contextStatus":"needs-context"},{"id":"W20218-0013","start":1124,"end":1316,"quote":"思翁书画俱是大作手，其画宗北苑，而兼得大，小米之长，尚在第二乘，惟书法无古无今，不名一格，而能卓然成家，盖天资高妙，直在古人上也。余尝见思一画卷，用笔淹润，秀绝人寰，后有款云：「  时年八十有一。」又见一书卷，临锺，王，虞，储，颜，柳及苏，黄诸家，后有题云：「 此数帖余临仿一生，才得十之三四，可脱去拘束之习。」书时亦年八十一。夫以思翁之天资学力，尚作书作画，老而不衰，自成大家也。\n","category":"书家评价","note":"评董书成家与晚年临古不辍，引其题卷自述。","contextStatus":"complete"},{"id":"W20218-0014","start":1318,"end":1662,"quote":"近日所称海内书家者，有三人焉：「一为诸城刘文清公；一为钱塘梁山舟侍讲；一为丹徒王梦楼太守也。或论文清书如枯禅入定，侍讲书如布帛菽粟，太守书如倚门卖俏。余谓此论太苛。文清本从松雪入手，灵峭异常，而误于《淳化阁帖》，遂至模棱终老，如商鼎、周彝，非不古而不适于用。侍讲早年亦宗赵、董，惟自壮至老笔笔自运，不屑依傍古人，故所书全无帖意，如旧家子弟，不过循规蹈矩，