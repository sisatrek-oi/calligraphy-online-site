":"tasks/2026-10-18-part3-feedback-review/member-input/第3份-逐页校勘 (1).txt","reviewCsvPath":"tasks/2026-10-18-part3-feedback-review/member-input/第3份-TXT校验表 (1).csv"}},{"start":10,"end":11,"sourceTextSha256":"01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b","id":"local-540-16-17","page_id":540,"origin":"legacy-reviewed-txt","rawStart":16,"rawEnd":17,"reviewedTextSha256":"1963fb8971b0964e522c8427cb87c0173a9b734bf6477d0232c9a107482039dd","displayUnitOrigins":[[16,17]],"legacySource":{"kind":"human-txt","page":540,"part":3,"label":"人工审核原TXT","verifiedBy":"宋品宣","verifiedAt":"2026-10-13T10:10:44.751Z","revision":"1963fb8971b0964e522c8427cb87c0173a9b734bf6477d0232c9a107482039dd","textSha256":"1963fb8971b0964e522c8427cb87c0173a9b734bf6477d0232c9a107482039dd","fileSha256":"337dfa6c51e668ea709348ab712a3393735bf97aa642fd0d59f41a894d9ef262","txtPath":"tasks/2026-10-18-part3-feedback-review/member-input/第3份-逐页校勘 (1).txt","reviewCsvPath":"tasks/2026-10-18-part3-feedback-review/member-input/第3份-TXT校验表 (1).csv"}},{"start":13,"end":21,"sourceTextSha256":"97005395ce1b1b40cd8ba8b43a08035bb38bf74f8e2f76a2348390c451f2b732","id":"word-书法雅言-24","page_id":"attachment:书法雅言.docx","work":"书法雅言","author":"项穆","type":"text","chapterHint":"目录","root_id":"4mnGjfZG3U9r2tkuBaFQaQ","origin":"wolai-word","rawStart":0,"rawEnd":8},{"start":23,"end":28,"sourceTextSha256":"23c03dcdf4f6f3893f4387970f52f075bc0a949cc511ffc1335532a8fdc974c3","id":"word-书法雅言-213","page_id":"attachment:书法雅言.docx","work":"书法雅言","author":"项穆","type":"text","chapterHint":"中和","root_id":"4mnGjfZG3U9r2tkuBaFQaQ","origin":"wolai-word","rawStart":0,"rawEnd":5},{"start":30,"end":350,"sourceTextSha256":"d65de3ff576c6c07256b4b58d358fcc7e97c8edd0f8caf5043fefd7df7002a39","id":"word-书法雅言-217","page_id":"attachment:书法雅言.docx","work":"书法雅言","author":"项穆","type":"text","chapterHint":"中和","root_id":"4mnGjfZG3U9r2tkuBaFQaQ","origin":"wolai-word","rawStart":0,"rawEnd":320},{"start":352,"end":756,"sourceTextSha256":"54603cfd93c20d6a