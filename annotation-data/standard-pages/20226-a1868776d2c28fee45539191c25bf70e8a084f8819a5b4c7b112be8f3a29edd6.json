534,535],[535,536],[536,537],[537,538],[538,539],[539,540],[540,541],[541,542],[542,543],[543,544],[544,545],[545,546],[546,547],[547,548],[548,549],[549,550],[550,551],[551,552],[552,553],[553,554],[554,555]],"legacySource":{"kind":"human-txt","page":768,"part":3,"label":"人工审核原TXT","verifiedBy":"彭鹏","verifiedAt":"2026-10-19T11:38:52.041Z","revision":"ec7483a6145ffbf25b883b965dfbc51f7b348e328147b77e61bfeff8e59a7fb9","textSha256":"ec7483a6145ffbf25b883b965dfbc51f7b348e328147b77e61bfeff8e59a7fb9","fileSha256":"08604f1942cd7018a3093aab9901d02c5bfcdc39d59d35578ce621c5a1eeefa5","txtPath":"tasks/2026-10-21-review-package-update/extracted/member-7-part-3/第3份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/extracted/member-7-part-3/第3份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/extracted/member-7-part-3/第3份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":5,"quote":"尊碑第二\n","role":"structure","category":"结构信息","note":"原分篇题。","contextStatus":"complete"},{"start":5,"end":7,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":7,"end":85,"quote":"晋人之书流传曰帖，其真迹至明犹有存者，故宋、元、明人之为帖学宜也。夫纸寿不过千年，流及国朝，则不独六朝遗墨不可复睹，即唐人钩本，已等凤毛矣。故今日所传诸帖，","role":"theory","category":"书史书体","note":"以纸寿和真迹亡佚解释宋元明学帖与当代条件之异；句接767页。","contextStatus":"needs-context"},{"start":85,"end":87,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":87,"end":222,"quote":"无论何家，无论何帖，大抵宋、明人重钩屡翻之本。名虽羲、献，面目全非，精神尤不待论。\n譬如子孙曾元，虽出自某人，而体貌则迥别。国朝之帖学，荟萃于得天、石菴，然已远逊明人，况其他乎！流败既甚，师帖者绝不见工。物极必反，天理固然。道光之后，碑学中兴，盖事势推迁，不能自已也。\n","role":"theory","category":"书史书体","note":"承766页以重钩翻刻失真、清人帖学退步说明碑学中兴。","contextStatus":"needs-context"},{"start":222,"end":224,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":224,"end":428,"quote":"乾隆之世，已厌旧学。冬心、板桥，参用隶笔，然失则怪，此欲变而不知变者。汀洲精于八分，以其八分为真书，师仿《吊比干文》，瘦劲独绝。怀宁一老，实丁斯会，既以集篆隶之大成，其隶楷专法六朝之碑，古茂浑朴，实与汀洲分分、隶之治，而启碑法之门。开山作祖，允推二子。即论书法，视覃溪老人终身欧、虞，褊隘浅弱，何啻天壤邪？吾粵吴荷屋中丞，帖学名家，其书为吾粵冠。然窥其笔法，亦似得自《张黑女碑》，若怀宁则得于《崔敬邕》也。\n","role":"theory","category":"书家评价","note":"评金农郑燮伊秉绶邓石如翁方纲吴荣光等取法，推伊邓开碑门。","contextStatus":"complete"},{"start":428,"end":430,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":430,"end":530,"quote":"阮文达亦作旧体者，然其为《南北书派论》，深通此事，知帖学之大坏，碑学之当法，南北朝碑之可贵。此盖通人达识，能审时宜、辨轻重也；惜见碑犹少，未暇发撝，犹土鼓蕢桴，椎轮大辂，仅能伐木开道，作之先声而已。\n","role":"theory","category":"作品评价","note":"评阮元《南北书派论》审时开道而所见未广。","contextStatus":"complete"},{"start":530,"end":532,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":532,"end":611,"quote":"碑学之兴，乘帖学之坏，亦因金石之大盛也。乾、嘉之后，小学最盛，谈者莫不藉金石以为考经证史之资。专门搜辑箸述之人既多，出土之碑亦盛，于是山岩、屋壁、荒野、穷郊，","role":"theory","category":"书史书体","note":"将碑兴兼系金石考经证史和出土搜辑，列举续768页。","contextStatus":"needs-context"},{"start":611,"end":613,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":613,"end":819,"quote":"或拾从耕父之锄，或搜自官厨之石，洗濯而发其光采，摹拓以广其流传。若平津孙氏、侯官林氏、偃师武氏、青浦王氏，皆辑成巨帙，遍布海内。其馀为《金石存》、《金石契》、《金石图》、《金石志》、《金石索》、《金石聚》、《金石续编》、《金石补编》等书，殆难悉数。故今南北诸碑，多嘉、道以后新出土者。即吾今所见碑，亦多《金石萃编》所未见者。出土之日多可证矣。出碑既多，考证亦盛，于是碑学蔚为大国。适乘帖微，入缵大统，亦其宜也。\n","role":"theory","category":"书史书体","note":"承767页记发现、摹拓与金石著录推动碑学蔚盛。","contextStatus":"needs-context"},{"start":819,"end":821,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":821,"end":917,"quote":"泾县包氏以精敏之资，当金石之盛，传完白之法，独得蕴奥；大启秘藏，箸为《安吴论书》，表新碑，宣笔法，于是此学如日中天。迄于咸、同，碑学大播，三尺之童，十室之社，莫不口北碑，写魏体，盖俗尚成矣。\n","role":"theory","category":"书史书体","note":"论包世臣承邓法、著安吴论书和咸同魏体普及。","contextStatus":"complete"},{"start":917,"end":919,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":919,"end":1072,"quote":"今日欲尊帖学，则翻之已坏，不得不尊碑；欲尚唐碑，则磨之已坏，不得不尊南北朝碑。尊之者，非以其古也：笔画完好，精神流露，易于临摹，一也；可以攷隶楷之变，二也；可以攷后世之源流，三也；唐言结构，宋尚意态，六朝碑各体毕备，四也；笔法舒长刻入，雄奇角出，迎接不暇，实为唐、宋之所无有，五也。有是五者，不亦宜于尊乎！","role":"theory","category":"论争辨析","note":"因帖翻坏、唐碑磨坏而尊南北朝碑，列完好、考变、溯源、备体、笔法五由。","contextStatus":"complete"}],"candidates":[{"id":"W20226-0001","start":7,"end":85,"quote":"晋人之书流传曰帖，其真迹至明犹有存者，故宋、元、明人之为帖学宜也。夫纸寿不过千年，流及国朝，则不独六朝遗墨不可复睹，即唐人钩本，已等凤毛矣。故今日所传诸帖，","category":"书史书体","note":"以纸寿和真迹亡佚解释宋元明学帖与当代条件之异；句接767页。","contextStatus":"needs-context"},{"id":"W20226-0002","start":87,"end":222,"quote":"无论何家，无论何帖，大抵宋、明人重钩屡翻之本。名虽羲、献，面目全非，精神尤不待论。\n譬如子孙曾元，虽出自某人，而体貌则迥别。国朝之帖学，荟萃于得天、石菴，然已远逊明人，况其他乎！流败既甚，师帖者绝不见工。物极必反，天理固然。道光之后，碑学中兴，盖事势推迁，不能自已也。\n","category":"书史书体","note":"承766页以重钩翻刻失真、清人帖学退步说明碑学中兴。","contextStatus":"needs-context"},{"id":"W20226-0003","start":224,"end":428,"quote":"乾隆之世，已厌旧学。冬心、板桥，参用隶笔，然失则怪，此欲变而不知变者。汀洲精于八分，以其八分为真书，师仿《吊比干文》，瘦劲独绝。怀宁一老，实丁斯会，既以集篆隶之大成，其隶楷专法六朝之碑，古茂浑朴，实与汀洲分分、隶之治，而启碑法之门。开山作祖，允推二子。即论书法，视覃溪老人终身欧、虞，褊隘浅弱，何啻天壤邪？吾粵吴荷屋中丞，帖学名家，其书为吾粵冠。然窥其笔法，亦似得自《张黑女碑》，若怀宁则得于《崔敬邕》也。\n","category":"书家评价","note":"评金农郑燮伊秉绶邓石如翁方纲吴荣光等取法，推伊邓开碑门。","contextStatus":"complete"},{"id":"W20226-0004","start":430,"end":530,"quote":"阮文达亦作旧体者，然其为《南北书派论》，深通此事，知帖学之大坏，碑学之当法，南北朝碑之可贵。此盖通人达识，能审时宜、辨轻重也；惜见碑犹少，未暇发撝，犹土鼓蕢桴，椎轮大辂，仅能伐木开道，作之先声而已。\n","category":"作品评价","note":"评阮元《南北书派论》审时开道而所见未广。","contextStatus":"complete"},{"id":"W20226-0005","start":532,"end":611,"quote":"碑学之兴，乘帖学之坏，亦因金石之大盛也。乾、嘉之后，小学最盛，谈者莫不藉金石以为考经证史之资。专门搜辑箸述之人既多，出土之碑亦盛，于是山岩、屋壁、荒野、穷郊，","category":"书史书体","note":"将碑兴兼系金石考经证史和出土搜辑，列举续768页。","contextStatus":"needs-context"},{"id":"W20226-0006","start":613,"end":819,"quote":"或拾从耕父之锄，或搜自官厨之石，洗濯而发其光采，摹拓以广其流传。若平津孙氏、侯官林氏、偃师武氏、青浦王氏，皆辑成巨帙，遍布海内。其馀为《金石存》、《金石契》、《金石图》、《金石志》、《金石索》、《金石聚》、《金石续编》、《金石补编》等书，殆难悉数。故今南北诸碑，多嘉、道以后新出土者。即吾今所见碑，亦多《金石萃编》所未见者。出土之日多可证矣。出碑既多，考证亦盛，于是碑学蔚为大国。适乘帖微，入缵大统，亦其宜也。\n","category":"书史书体","note":"承767页记发现、摹拓与金石著录推动碑学蔚盛。","contextStatus":"needs-context"},{"id":"W20226-0007","start":821,"end":917,"quote":"泾县包氏以精敏之资，当金石之盛，传完白之法，独得蕴奥；大启秘藏，箸为《安吴论书》，表新碑，宣笔法，于是此学如日中天。迄于咸、同，碑学大播，三尺之童，十室之社，莫不口北碑，写魏体，盖俗尚成矣。\n","category":"书史书体","note":"论包世臣承邓法、著安吴论书和咸同魏体普及。","contextStatus":"complete"},{"id":