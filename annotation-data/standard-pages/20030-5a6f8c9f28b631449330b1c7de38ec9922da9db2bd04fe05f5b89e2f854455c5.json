4,85],[85,86],[86,87],[87,88],[88,89],[89,90],[90,91],[91,92],[92,93],[93,94],[94,95],[95,96],[96,97],[97,98]],"legacySource":{"kind":"human-txt","page":56,"part":1,"label":"人工审核原TXT","verifiedBy":"肖源","verifiedAt":"2026-10-19T08:19:32.125Z","revision":"99d436728a2c14574f0b248f34ebdbfa57c8d706c41c42ca26ce8b479ad49815","textSha256":"99d436728a2c14574f0b248f34ebdbfa57c8d706c41c42ca26ce8b479ad49815","fileSha256":"79106ac65424604a53ca79186ecc2bad7dbbdc92135f4d626b3d9b63cebb6e55","txtPath":"tasks/2026-10-21-review-package-update/extracted/member-1-part-1/第1份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/extracted/member-1-part-1/第1份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/extracted/member-1-part-1/第1份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":3,"quote":"羊欣\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":3,"end":5,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":5,"end":59,"quote":"臣僧虔启：昨奉敕，须古来能书人名。臣所知局狭，不辨广悉，辄条疏上呈羊欣所撰录一卷，寻索未得，续更呈闻。谨启。","role":"editorial","category":"编纂说明","note":"呈送能书人名录的启辞。","contextStatus":"complete"},{"start":59,"end":61,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":61,"end":82,"quote":"秦丞相李斯，秦中车府令赵高，右二人善大篆。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":82,"end":84,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":84,"end":132,"quote":"秦狱吏程邈，善大篆。得罪始皇，囚于云阳狱，增减大篆体，去其繁复，始皇善之，出为御史，名书曰隶书。","role":"theory","category":"书史书体","note":"述文字书体源流、分类或传承，兼有书家事迹。","contextStatus":"complete"},{"start":132,"end":134,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":134,"end":164,"quote":"扶风曹喜。后汉人，不知其官。善篆、隶，篆小异李斯，见师一时。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":164,"end":166,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":166,"end":208,"quote":"陈留蔡邕。后汉左中郎将。善篆、隶，采斯、喜之法，真定《宣父碑》文犹传于世。篆者师焉。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":208,"end":210,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":210,"end":247,"quote":"杜陵陈遵，后汉人，不知其官。善篆、隶，每书，一座皆惊，时人谓为“陈惊座”。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":247,"end":249,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":249,"end":265,"quote":"上谷王次仲，后汉人，作八分楷法。","role":"theory","category":"书史书体","note":"述文字书体源流、分类或传承，兼有书家事迹。","contextStatus":"complete"},{"start":265,"end":267,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":267,"end":346,"quote":"师宜官\n，后汉人，不知何许人、何官。能为大字方一丈，小字方寸千言。《耿球碑》是宜官书，甚是矜重。或空至酒家，先书其壁，观者云集，酒因大售。俟其饮足，削书而退。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":346,"end":348,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":348,"end":393,"quote":"安定梁鹄，后汉人，官至选部尚书。得师宜官法，魏武重之，常以鹄书悬帐中。宫殿题署多是鹄手也。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":393,"end":395,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":395,"end":462,"quote":"陈留邯郸淳，为魏临淄侯文学。得次仲法，名在鹄后。毛弘，鹄弟子。今秘书八分，皆传弘法。又有左子邑，与淳小异。京兆杜度为魏齐相，始有草名。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":462,"end":464,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":464,"end":606,"quote":"安平崔瑗，后汉济北相，亦善草书。平苻坚，得摹崔瑗书，王子敬云：“极似张伯英。”瑗子实，官至尚书，亦能草书。张农张芝，高尚不仕。善草书，精劲绝伦。家之衣帛，必先书而后练；临池学书，池水尽墨。每书，云“匆匆不暇草书”。人谓为“草圣”。芝弟昶，汉黄门侍郎，亦能草，今世云芝草者。多是昶作也。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":606,"end":608,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":608,"end":754,"quote":"姜诩、梁宣、田彦和及司徒韦诞，皆英弟子，并善草，诞书最优。诞字仲将，京兆人，善楷书，汉魏宫馆宝器，皆是诞亲手写。魏明帝起凌云台，误先钉榜而未题，以笼子盛诞，辘轳长口引之，使就榜书之。榜去地二十五丈，诞甚危惧。乃掷其笔，比下焚之。乃诫子孙，绝此楷法，著之家令。官至鸿胪少卿。诞子少季，亦有能称。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":754,"end":756,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":756,"end":819,"quote":"罗晖、赵袭，不详何许人，与伯英同时，见称西州，而矜许自与，众颇惑之。伯英与朱宽书，自叙云：“上比崔、杜不足，下方罗、赵有馀。”","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":819,"end":821,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":821,"end":835,"quote":"河间张超亦善草，不及崔、张。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":835,"end":837,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":837,"end":851,"quote":"刘德升善为行书，不详何许人。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":851,"end":853,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":853,"end":969,"quote":"颖川锺繇，魏太尉；同郡胡昭，公车征。二子俱学于德升，而胡书肥，钟书瘦。钟有三体：一曰铭石之书，最妙者也；二曰章程书，传秘书、教小学者 也；三曰行押书，相闻者也。三法皆世人所善。繇子会，镇西将军。绝能学父书，改易邓艾上事，皆莫有知者。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":969,"end":971,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":971,"end":1059,"quote":"河东卫觊，字伯儒，魏尚书仆射，善草及古文，略尽其妙。草体微瘦，而笔迹精熟。觊子瓘，字伯玉，为晋太保。采张芝法，以觊法参之，更为草藁。 草藁是相闻书也。瓘子恒，亦善书，博识古文。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1059,"end":1061,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1061,"end":1098,"quote":"敦煌索靖，字幼安，张芝姊之孙，晋征南司马，亦善草书。陈国何元公，亦善草书。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1098,"end":1100,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1100,"end":1117,"quote":"吴人皇象，能草，世称“沉著痛快”。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1117,"end":1119,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1119,"end":1208,"quote":"荥阳陈畅，晋秘书令史，善八分，晋宫、观、城门，皆畅书也。荥阳杨肇，晋荆州刺史，善草隶。潘岳诔曰：“草隶兼善，尺牍必珍，足无缀行，手不释文，翰动若飞，纸落如云。”肇孙经，亦善草隶。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1208,"end":1210,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1210,"end":1243,"quote":"京兆杜畿，魏尚书仆射；子恕，东郡太守；孙预，荆州刺史：三世善草藁。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1243,"end":1245,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1245,"end":1255,"quote":"晋齐王攸，善草行书。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1255,"end":1257,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1257,"end":1282,"quote":"泰山羊忱，晋徐州刺史；羊固，晋临海太守：并善行书。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1282,"end":1284,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1284,"end":1311,"quote":"江夏李式，晋侍中，善写隶、草。弟定，子公府，能名同式。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1311,"end":1313,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1313,"end":1334,"quote":"晋中书郎李充母，善钟法卫夫人，王逸少之师。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1334,"end":1336,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1336,"end":1361,"quote":"琅邪王廙，晋平南将军，荆州刺史，能章楷，谨传钟法。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1361,"end":1363,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1363,"end":1379,"quote":"晋丞相王导，善藁、行。廙从兄也。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1379,"end":1381,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1381,"end":1404,"quote":"王恬，晋中将军，会稽内史，善隶书。导第二子也。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1404,"end":1406,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1406,"end":1449,"quote":"王洽，晋中书令、领军将军，众书通善，尤能隶、行。从兄羲之云：“弟书遂不减吾。”恬弟也。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1449,"end":1451,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1451,"end":1469,"quote":"王珉，晋中书令，善隶、行。洽少子也。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1469,"end":1471,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1471,"end":1511,"quote":"王羲之，晋右将军、会稽内史，博精群法，特善草隶。羊欣云：“古今莫二。”廙兄子也。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1511,"end":1513,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1513,"end":1564,"quote":"王献之，晋中书令，善隶、藁，骨势不及父，而媚趣过之。羲之第七子也。兄玄之、微之，兄子淳之，并善草、行。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1564,"end":1566,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1566,"end":1590,"quote":"王允之，卫军将军、会稽内史，亦善草、行。舒子也。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1590,"end":1592,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1592,"end":1657,"quote":"太原王濛，晋司徒左长史，能革、隶。子修，琅琊王文学。善隶、行，与羲之善，故殆穷其妙。早亡，未尽其美。子敬每省修书云：“咄咄逼人。”","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1657,"end":1659,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1659,"end":1678,"quote":"王绥，晋冠军将军、会稽内史，善隶、行。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1678,"end":1680,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1680,"end":1718,"quote":"高平郗愔，晋司空、会稽内史。善章草，亦能隶。郗超，晋中书郎，亦善草。愔子也。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1718,"end":1720,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1720,"end":1759,"quote":"颖川庾亮，晋太尉，善草、行。庾翼，晋荆州刺史。善隶、行，时与羲之齐名。亮弟也。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1759,"end":1761,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1761,"end":1775,"quote":"陈郡谢安，晋太傅，善隶、行。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1775,"end":1777,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1777,"end":1798,"quote":"高阳许静民，镇军参军，善隶、草，羲之高足。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1798,"end":1800,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1800,"end":1837,"quote":"晋穆帝时，有张翼善学人书，写羲之表，表出，经日不觉，后云：“几欲乱真。”。","role":"theory","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"start":1837,"end":1839,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1839,"end":1857,"quote":"会稽隐士谢敷，胡人康昕，并攻隶、草。","role":"biography","category":"背景生平","note":"人物身份、亲属或能书记录，缺少展开的书论。","contextStatus":"complete"},{"start":1857,"end":1859,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1859,"end":1916,"quote":"飞白本是宫殿题八分之轻者，全用楷法。吴时张弘好学不仕，常著乌巾，时人号为“张乌巾”。此人特善飞白，能书者鲜不好之。","role":"theory","category":"书史书体","note":"述文字书体源流、分类或传承，兼有书家事迹。","contextStatus":"complete"},{"start":1916,"end":1918,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1918,"end":2055,"quote":"羊欣（三七〇年——四四二年），南朝宋书法家。字敬元，泰山南城（今山东费县西南）人，官至中散大夫、义兴太守。亲受王献之传授书法。沈约称其善于隶书，子敬之后，可称独步。时谚曰：「买王得羊，不失所望。」而贬之者则谓欣学献之，终不能度越献之规矩，自成一家，故又有「婢作夫人」之诮。\n","role":"biography","category":"人物生平","note":"编者传记介绍身份、学书经历与声誉；引述买王得羊和婢作夫人两种评价，仍属编者介绍层。","contextStatus":"complete"},{"start":2055,"end":2057,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2057,"end":2274,"quote":"《采古来能书人名》或作《古来能书人名录》，一卷。卷首有王僧虔启云：「昨奉勑，须古来能书人名，臣所知局狭，不辩广悉，辄条疏上呈羊欣所撰录一卷，寻索未得，续更呈闻。谨启。」《说郛》本误以「辄条疏上呈」为句，以此书为王僧虔撰。唐张彦远作《法书要录》，于其题下注云：齐王僧虔录，宋羊欣所传者，目录直书宋羊欣《采能书人名》。六朝至唐，时代较近，自可征信，且原文以「辄条疏上呈羊欣所撰录一卷」为句，文义本甚明了。编中列自秦至晉能书者凡六十九人。\n","role":"editorial","category":"编者题解","note":"编者考辨书名、王僧虔录与羊欣所撰之关系，说明收录范围。","contextStatus":"complete"},{"start":2274,"end":2276,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2276,"end":2284,"quote":"采古来能书人名\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":2284,"end":2286,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2286,"end":2341,"quote":"臣僧虔启：昨奉勅，须古来能书人名。臣所知局狭，不辨广悉，辄条疏上呈羊欣所撰录一卷，寻索未得，续更呈闻。谨启。\n","role":"structure","category":"结构信息","note":"王僧虔奉敕上呈所录的启文，不是另篇书论。","contextStatus":"complete"}],"candidates":[{"id":"W20030-0001","start":61,"end":82,"quote":"秦丞相李斯，秦中车府令赵高，右二人善大篆。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0002","start":84,"end":132,"quote":"秦狱吏程邈，善大篆。得罪始皇，囚于云阳狱，增减大篆体，去其繁复，始皇善之，出为御史，名书曰隶书。","category":"书史书体","note":"述文字书体源流、分类或传承，兼有书家事迹。","contextStatus":"complete"},{"id":"W20030-0003","start":134,"end":164,"quote":"扶风曹喜。后汉人，不知其官。善篆、隶，篆小异李斯，见师一时。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0004","start":166,"end":208,"quote":"陈留蔡邕。后汉左中郎将。善篆、隶，采斯、喜之法，真定《宣父碑》文犹传于世。篆者师焉。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0005","start":210,"end":247,"quote":"杜陵陈遵，后汉人，不知其官。善篆、隶，每书，一座皆惊，时人谓为“陈惊座”。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0006","start":249,"end":265,"quote":"上谷王次仲，后汉人，作八分楷法。","category":"书史书体","note":"述文字书体源流、分类或传承，兼有书家事迹。","contextStatus":"complete"},{"id":"W20030-0007","start":267,"end":346,"quote":"师宜官\n，后汉人，不知何许人、何官。能为大字方一丈，小字方寸千言。《耿球碑》是宜官书，甚是矜重。或空至酒家，先书其壁，观者云集，酒因大售。俟其饮足，削书而退。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0008","start":348,"end":393,"quote":"安定梁鹄，后汉人，官至选部尚书。得师宜官法，魏武重之，常以鹄书悬帐中。宫殿题署多是鹄手也。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0009","start":395,"end":462,"quote":"陈留邯郸淳，为魏临淄侯文学。得次仲法，名在鹄后。毛弘，鹄弟子。今秘书八分，皆传弘法。又有左子邑，与淳小异。京兆杜度为魏齐相，始有草名。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0010","start":464,"end":606,"quote":"安平崔瑗，后汉济北相，亦善草书。平苻坚，得摹崔瑗书，王子敬云：“极似张伯英。”瑗子实，官至尚书，亦能草书。张农张芝，高尚不仕。善草书，精劲绝伦。家之衣帛，必先书而后练；临池学书，池水尽墨。每书，云“匆匆不暇草书”。人谓为“草圣”。芝弟昶，汉黄门侍郎，亦能草，今世云芝草者。多是昶作也。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0011","start":608,"end":754,"quote":"姜诩、梁宣、田彦和及司徒韦诞，皆英弟子，并善草，诞书最优。诞字仲将，京兆人，善楷书，汉魏宫馆宝器，皆是诞亲手写。魏明帝起凌云台，误先钉榜而未题，以笼子盛诞，辘轳长口引之，使就榜书之。榜去地二十五丈，诞甚危惧。乃掷其笔，比下焚之。乃诫子孙，绝此楷法，著之家令。官至鸿胪少卿。诞子少季，亦有能称。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0012","start":756,"end":819,"quote":"罗晖、赵袭，不详何许人，与伯英同时，见称西州，而矜许自与，众颇惑之。伯英与朱宽书，自叙云：“上比崔、杜不足，下方罗、赵有馀。”","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0013","start":821,"end":835,"quote":"河间张超亦善草，不及崔、张。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0014","start":837,"end":851,"quote":"刘德升善为行书，不详何许人。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0015","start":853,"end":969,"quote":"颖川锺繇，魏太尉；同郡胡昭，公车征。二子俱学于德升，而胡书肥，钟书瘦。钟有三体：一曰铭石之书，最妙者也；二曰章程书，传秘书、教小学者 也；三曰行押书，相闻者也。三法皆世人所善。繇子会，镇西将军。绝能学父书，改易邓艾上事，皆莫有知者。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0016","start":971,"end":1059,"quote":"河东卫觊，字伯儒，魏尚书仆射，善草及古文，略尽其妙。草体微瘦，而笔迹精熟。觊子瓘，字伯玉，为晋太保。采张芝法，以觊法参之，更为草藁。 草藁是相闻书也。瓘子恒，亦善书，博识古文。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0017","start":1061,"end":1098,"quote":"敦煌索靖，字幼安，张芝姊之孙，晋征南司马，亦善草书。陈国何元公，亦善草书。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0018","start":1100,"end":1117,"quote":"吴人皇象，能草，世称“沉著痛快”。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0019","start":1119,"end":1208,"quote":"荥阳陈畅，晋秘书令史，善八分，晋宫、观、城门，皆畅书也。荥阳杨肇，晋荆州刺史，善草隶。潘岳诔曰：“草隶兼善，尺牍必珍，足无缀行，手不释文，翰动若飞，纸落如云。”肇孙经，亦善草隶。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0020","start":1336,"end":1361,"quote":"琅邪王廙，晋平南将军，荆州刺史，能章楷，谨传钟法。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0021","start":1406,"end":1449,"quote":"王洽，晋中书令、领军将军，众书通善，尤能隶、行。从兄羲之云：“弟书遂不减吾。”恬弟也。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0022","start":1471,"end":1511,"quote":"王羲之，晋右将军、会稽内史，博精群法，特善草隶。羊欣云：“古今莫二。”廙兄子也。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0023","start":1513,"end":1564,"quote":"王献之，晋中书令，善隶、藁，骨势不及父，而媚趣过之。羲之第七子也。兄玄之、微之，兄子淳之，并善草、行。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0024","start":1592,"end":1657,"quote":"太原王濛，晋司徒左长史，能革、隶。子修，琅琊王文学。善隶、行，与羲之善，故殆穷其妙。早亡，未尽其美。子敬每省修书云：“咄咄逼人。”","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0025","start":1800,"end":1837,"quote":"晋穆帝时，有张翼善学人书，写羲之表，表出，经日不觉，后云：“几欲乱真。”。","category":"书家评价","note":"述书家擅长、师承或优劣；兼有生平背景。","contextStatus":"complete"},{"id":"W20030-0026","start":1859,"end":1916,"quote":"飞白本是宫殿题八分之轻者，全用楷法。吴时张弘好学不仕，常著乌巾，时人号为“张乌巾”。此人特善飞白，能书者鲜不好之。","category":"书史书体","note":"述文字书体源流、分类或传承，兼有书家事迹。","contextStatus":"complete"}],"contextNotes":[],"summary":"wolai优先标准；仅本地独有段落明确保留。AI初标等待整章通读。","annotationRevision":"e7fe50074010ff9bf7316782d78d91a52f9f5f0cbce53ce153996311bda6abcb"}