,[398,399],[399,400],[400,401],[401,402],[402,403],[403,404],[404,405],[405,406],[406,407],[407,408],[408,409],[409,410],[410,411],[411,412],[419,420],[420,421],[421,422],[422,423],[423,424],[424,425],[425,426],[426,427],[427,428],[428,429],[429,430],[430,431],[431,432],[432,433],[433,434],[434,435],[435,436],[436,437],[437,438],[438,439]],"legacySource":{"kind":"human-txt","page":837,"part":4,"label":"人工审核原TXT","verifiedBy":"帅睿","verifiedAt":"2026-10-20T08:56:06.786Z","revision":"83caf8d6f2c0c3ecb2d596f9367359dc883e8fdbab7a43a751edd69c07fab60b","textSha256":"83caf8d6f2c0c3ecb2d596f9367359dc883e8fdbab7a43a751edd69c07fab60b","fileSha256":"1185f1a3fa26a44f344bcc8de1c99f9576cacd75c8b6baf2d2fd9087b7e29e57","txtPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":6,"quote":"十家第十五\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":6,"end":8,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":8,"end":129,"quote":"三古能书不箸己名。《石鼓》为史籀作，乃议拟之辞，《延陵墓石》为孔子题，乃附会之说。秦诸山石刻，虽史偁相斯所作，亦不箸名，盖风气浑厚，末艺偏长，不以自夸也。沿及汉魏，犹存此风。今汉存碑，其书人可考者，惟《武班碑》为纪伯允书，《郙阁颂》为仇绋书，","role":"theory","category":"书史书体","note":"考三古书人不署名及史籀孔子传说，述秦汉碑书作者可考状况。","contextStatus":"needs-context"},{"start":129,"end":131,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":131,"end":405,"quote":"《衡方碑》为朱登书，《樊敏碑》为刘懆书，《华岳碑》郭香察书，或谓「察」者察人之书，非人名也。或谓蔡邕书，然后人附会邕书太多，未必即邕也。《石经书》字体不同，自蔡邕、堂溪典外，《公羊》末有「臣赵䧕、议郎臣刘宏、郎中臣张文、臣苏陵、臣傅桢」。《论语》末题云「诏书与博士臣左立、郎中臣孙表」。《上尊号奏》锺繇书，《受禅表》卫觊书，鲁《孔子庙碑》梁鹄书，《天发神谶》皇象书，《封禅国山》苏建书，此外无考。降逮六朝，书法日工，而啖名未甚，虽《张猛龙》之精能，《爨龙颜》之高浑，犹不自箸，即隋世尚不炫能于此，至于唐代，斯风遂坠，片石只碣，靡不书名，遂为成例。\n","role":"theory","category":"论争辨析","note":"续汉碑作者，区分碑末题名、后人附会及可考范围，说明唐前署名少。","contextStatus":"complete"},{"start":405,"end":407,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":407,"end":598,"quote":"南北朝碑，书人名者，略可指数，今钩考之，凡得十六人，皆工绝一时，精能各擅者也。\n又「淇园」二字，为司马均书，字迹寡少，未成门户。王羲之《曹娥碑》、王献之《保母志》、陶贞白之《瘗鹤铭》，疑难遽定，不复录。《天柱山铭》为郑述祖书，《陇东王感孝颂》为梁恭之书，《华岳碑》为赵文渊书，郑氏世其家风，梁、赵得名前代，以其隶体不周时用，并从略焉。\n今著正书各成一体者，列为十家，箸所书碑述于后：","role":"theory","category":"书史书体","note":"述六朝可考书家十六人，舍司马均短字及羲献陶书争议与隶体，选正书成体十家。","contextStatus":"complete"},{"start":598,"end":600,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":600,"end":630,"quote":"寇谦之《嵩高灵庙碑》萧显庆《孙秋生造像》朱义章《始平公造像》","role":"theory","category":"书史书体","note":"列寇谦之、萧显庆、朱义章所书碑，以人系碑的书史名单。","contextStatus":"complete"},{"start":630,"end":632,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":632,"end":703,"quote":"崔浩《孝文皇帝吊比干墓文》王远《石门铭》郑道昭《云峰山四十二种》贝义渊《始兴王碑》王长儒《李仲璇修孔子庙碑》穆子容《太公吕望碑》释仙《报德像》","role":"theory","category":"书史书体","note":"续列崔浩王远郑道昭贝义渊王长儒穆子容释仙与其碑。","contextStatus":"complete"},{"start":703,"end":705,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":705,"end":787,"quote":"十家体皆迥异，各有所长，瘦硬莫如崔浩，奇古莫如寇谦之，雄重莫如朱义章，飞逸莫如王远，峻整莫如贝义渊，神韵莫如郑道昭，超爽莫如王长儒，浑厚莫如穆子容，雅朴莫如释仙。\n","role":"theory","category":"书家评价","note":"概括十家瘦硬奇古雄重飞逸峻整神韵超爽浑厚雅朴各长。","contextStatus":"complete"},{"start":787,"end":789,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":789,"end":972,"quote":"朱义章、贝义渊、萧显庆、释仙皆用方笔，王远、郑道昭、王长儒、穆子容则用圆笔，崔浩、寇谦之体兼隶楷，笔互方圆者也。九家皆源本分隶，崔浩则《褒斜》之遗，寇谦之则《韩勑》之嗣，朱义章则《东海庙》之后，王远、郑道昭则《西狭》之遗，尤其易见者也。十家各成流派，崔浩之派为褚遂良、柳公权、沈传师，贝义渊之派为欧阳询，王长儒之派为虞世南，王行满、穆子容之派为颜真卿，此其显然者也。","role":"theory","category":"用笔技法","note":"辨十家方圆笔与隶楷兼体，追汉分源流及欧褚柳沈虞颜等后传。","contextStatus":"complete"}],"candidates":[{"id":"W20239-0001","start":8,"end":129,"q