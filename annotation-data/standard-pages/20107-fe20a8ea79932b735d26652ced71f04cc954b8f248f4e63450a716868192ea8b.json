9],[289,290],[290,291],[291,292],[292,293],[293,294],[294,295],[295,296],[296,297],[297,298],[298,299],[306,307],[307,308],[308,309],[309,310],[310,311],[311,312],[312,313],[313,314],[314,315],[315,316],[316,317]],"legacySource":{"kind":"human-txt","page":375,"part":2,"label":"人工审核原TXT","verifiedBy":"郑雨荻","verifiedAt":"2026-10-19T12:00:28.290Z","revision":"b004f1a126d05540942abf68326d266b3286229c9fd6387a9d9f534700a8c18d","textSha256":"b004f1a126d05540942abf68326d266b3286229c9fd6387a9d9f534700a8c18d","fileSha256":"a7959b8ad3ac4b1328d4afcc5960761834bc9dbc83e2ea2d0c51808b9658a61c","txtPath":"tasks/2026-10-21-review-package-update/extracted/member-2-part-2/第2份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/extracted/member-2-part-2/第2份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/extracted/member-2-part-2/第2份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":3,"quote":"米芾\n","role":"structure","category":"结构信息","note":"原文篇章标题。","contextStatus":"complete"},{"start":3,"end":5,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":5,"end":71,"quote":"历观前贤论书，征引迂远，比况奇巧，如“龙跳天门，虎卧凤阁”，是何等语？或遣辞求工，去法逾远，无益学者。故吾所论，要在入人，不为溢辞。","role":"theory","category":"论争辨析","note":"反对迂远比况和溢辞，主张论书有益学者","contextStatus":"complete"},{"start":71,"end":73,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":73,"end":170,"quote":"吾书小字行书，有如大字。唯家藏真迹跋尾，间或有之，不以与求书者。心既贮之，随意落笔，皆得自然，备其古雅。壮岁未能立家，人谓吾书为集古字，盖取诸长处总而成之。既老始自成家，人见之，不知以何为祖也。","role":"theory","category":"学书方法","note":"自述集古诸长至自成一家，论自然古雅","contextStatus":"complete"},{"start":170,"end":172,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":172,"end":246,"quote":"江南吴、登州王子韶，大隶题榜有古意，吾儿友仁大隶题榜与之等。又幼儿友知代吾名书碑及手大字更无辨。门下许侍郎尤爱其小楷，云每小简可使令嗣书，谓友知也。","role":"theory","category":"书家评价","note":"评吴王及友仁友知题榜、小楷与代笔相似","contextStatus":"complete"},{"start":246,"end":248,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":248,"end":331,"quote":"老杜作《薛稷慧普寺》诗云：“郁郁三大字，蛟龙岌相缠。”今有石本得视之，乃是勾勒倒收笔锋，笔笔如蒸饼，“普”字如人握两拳，伸臂而立，丑怪难状。由是论之，古无真大字明矣。","role":"theory","category":"作品评价","note":"批评《慧普寺》榜字勾勒、圆笔与形态","contextStatus":"complete"},{"start":331,"end":333,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":333,"end":430,"quote":"葛洪“天台之观”飞白，为大字之冠、古今第一。欧阳询“道林之寺”，寒俭无精神。柳公权国清寺，大小不相称，费尽筋骨。裴休率意写牌，乃有真趣，不陷丑怪。真字甚易，唯有体势难，谓不如画算，勾，其势活也。","role":"theory","category":"作品评价","note":"比较诸寺榜字飞白、精神与体势","contextStatus":"complete"},{"start":430,"end":432,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":432,"end":505,"quote":"字之八面，唯尚真楷见之，大小各自有分。智永有八面已少钟法。丁道护，欧、虞笔始勾，古法亡矣。柳公权师欧，不及远甚，而为丑怪恶札之祖。自柳世始有俗书。","role":"theory","category":"书家评价","note":"以八面与钟法评智永丁欧虞柳，辨古俗","contextStatus":"complete"},{"start":505,"end":507,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":507,"end":573,"quote":"唐官告在世，为褚、陆、徐、峤之体，殊有不俗者。开元已来，缘明皇字体肥俗，始有徐浩以合时君所好，经生字亦自此肥，开元已前古气无复有矣。","role":"theory","category":"书史书体","note":"论开元以来官诰与经生字的肥俗风尚","contextStatus":"complete"},{"start":573,"end":575,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":575,"end":661,"quote":"唐人以徐浩比僧虔，甚失当。浩大小一伦，犹吏楷也。僧虔，萧子云传钟法，与子敬无异，大小各有分，不一伦。徐浩为颜真卿辟客书韵，自张颠血脉来，教颜大字促令小，小字展令大，非古也。","role":"theory","category":"书家评价","note":"辨徐浩与僧虔子云优劣，批评大小展促","contextStatus":"complete"},{"start":661,"end":663,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":663,"end":841,"quote":"石刻不可学，但自书使人刻之已非己书也，故必须真迹观之乃得趣。如颜真卿，每使家僮刻字，故会主人意，修改披撇，致大失真。唯吉州庐山题名，题讫而去，后人刻之，故皆得其真，无做作凡差，乃知颜出于褚也。又真迹皆无蚕头燕尾之笔，《与郭知运争坐位帖》有篆籀气，颜杰思也。柳与欧为丑怪恶札祖，其弟公绰乃不俗于兄，筋骨之说出于柳。世人但以怒张为筋骨，不知不怒张，自有筋骨焉。","role":"theory","category":"学书方法","note":"倡观真迹而不学失真石刻，兼评颜柳欧与筋骨","contextStatus":"complete"},{"start":841,"end":843,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":843,"end":890,"quote":"凡大字要如小字，小字要如大字。褚遂良小字如大字，其后经生祖述，间有造妙者。大字如小字未之见也。","role":"theory","category":"结体章法","note":"论大小字相通的体势尺度，举褚为例","contextStatus":"complete"},{"start":890,"end":892,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":892,"end":971,"quote":"世人多写大字时用力捉笔，字愈无筋骨神气，作圆笔头如蒸饼大，可鄙笑。要须如小字锋势备全，都无刻意做作，乃佳。自古及今，余不敏，实得之榜字，固已满世自有识者知之。","role":"theory","category":"用笔技法","note":"反对大字用力捉笔与造作，要求锋势全备","contextStatus":"complete"},{"start":971,"end":973,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":973,"end":1118,"quote":"石曼卿作佛号，都无回互转折之势，小字展令大，大字促令小，是颠教颜真卿谬论。盖字自有大小相称，且如写太一之殿，作四窠分，岂可将一字肥满一窠，以对殿字乎？盖自有相称大小，不展促也。余尝书天庆之观，天、之字皆四笔，庆、观字多画在下，各随其相称写之，挂起气势自带过，皆如大小一般，虽真有飞动之势也。","role":"theory","category":"结体章法","note":"反对机械展促，以太一及天庆榜字论大小相称","contextStatus":"complete"},{"start":1118,"end":1120,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1120,"end":1175,"quote":"书至隶兴，大篆古法大坏矣。篆籀各随字形大小，故知百物之状，活动圆备，各各自足，隶乃始有展促之势，而三代法亡矣。","role":"theory","category":"书史书体","note":"从篆籀转隶的大小展促变化论古法存亡","contextStatus":"complete"},{"start":1175,"end":1177,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1177,"end":1321,"quote":"欧、虞、褚、柳、颜皆一笔书也。安排费工，岂能垂世。李邕脱子敬，体乏纤浓。徐浩晚年力过，更无气骨，皆不如作郎官时婺州碑也。董孝子不空皆晚年恶札，全无妍媚，此自有识者知之；沈传师变格，自有超世真趣，徐不及也；御史萧诚书太原题名，唐人无出其右，为《司马系南岳真君观碑》，极有钟王趣，余皆不及矣。","role":"theory","category":"书家评价","note":"批评唐诸家安排费工，评徐浩沈萧等风格及作品","contextStatus":"complete"},{"start":1321,"end":1323,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1323,"end":1363,"quote":"智永临集千文，秀润圆劲，八面具备，有真迹。自颠沛字起在唐林夫处，他人所收不及也。","role":"theory","category":"作品评价","note":"评智永《千文》秀润圆劲及传本优劣","contextStatus":"complete"},{"start":1363,"end":1365,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1365,"end":1439,"quote":"字要骨格，肉须裹筋，筋须藏肉，帖乃秀润生布置，稳不俗，险不怪，老不枯，润不肥。变态贵形不贵苦，苦生怒，怒生怪；贵形不贵作，作入画，画入俗：皆字病也。","role":"theory","category":"审美风格","note":"论骨肉相裹、稳险老润与怒怪画俗之病","contextStatus":"complete"},{"start":1439,"end":1441,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1441,"end":1546,"quote":"“少成若天性，习惯若自然。”兹古语也。吾梦古衣冠人授以摺纸书，书法自此差进。写与他人，都不晓。蔡元长见而惊曰：“法何太遽异耶？”此公亦具眼人。章子厚以真自名，独称吾行草，欲吾书如排算子，然真字须有体势，乃佳尔。","role":"theory","category":"学书方法","note":"借习惯、授法与他评论楷书体势，混合梦境轶事","contextStatus":"complete"},{"start":1546,"end":1548,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1548,"end":1562,"quote":"颜鲁公行字可教，真便入俗品。","role":"theory","category":"书家评价","note":"评颜行可教而真入俗","contextStatus":"complete"},{"start":1562,"end":1564,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1564,"end":1591,"quote":"尹仁等古人书，不知此学吾书多。小儿作草书，大假有意思。","role":"theory","category":"书家评价","note":"评儿子学古实际多学己书及草书意味","contextStatus":"complete"},{"start":1591,"end":1593,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1593,"end":1621,"quote":"智永砚成臼，乃能到右军；若穿透，始到钟、索也。可永勉之。","role":"theory","category":"学书方法","note":"以智永磨砚比拟功力并劝勉","contextStatus":"complete"},{"start":1621,"end":1623,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1623,"end":1672,"quote":"一日不书，便觉思涩。想古人未尝片时废书也。因思苏之才《恒公至洛帖》字明意，殊有工，为天下法书第一。","role":"theory","category":"学书方法","note":"论每日不废书，兼推《恒公至洛帖》为第一","contextStatus":"complete"},{"start":1672,"end":1674,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1674,"end":1714,"quote":"半山庄台上多文公书，今不知存否。文公与杨凝式书人鲜知之。余语其故，公大赏其见鉴。","role":"theory","category":"书家评价","note":"辨王安石书学杨凝式，兼题迹存佚","contextStatus":"complete"},{"start":1714,"end":1716,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1716,"end":1745,"quote":"金陵幕山楼隶榜石，关蔚宗二十一年前书。想六朝宫殿榜皆如是。","role":"theory","category":"书史书体","note":"据幕山楼隶榜推想六朝宫殿题榜形制","contextStatus":"complete"},{"start":1745,"end":1747,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1747,"end":1790,"quote":"薛稷书慧普寺，老杜以为“蛟龙岌相缠”。今见其本，乃如柰重儿，握蒸饼势，信老杜不能书也。","role":"theory","category":"作品评价","note":"批评薛稷榜字并反驳杜诗称誉","contextStatus":"complete"},{"start":1790,"end":1792,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1792,"end":1818,"quote":"学书须得趣，他好但为乃入妙。别为一好萦之，便不工也。","role":"theory","category":"学书方法","note":"主张得趣专一，排除其他嗜好干扰","contextStatus":"complete"},{"start":1818,"end":1820,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1820,"end":1908,"quote":"海岳以书学博士召对。上问本朝以书名世者凡数人。海岳各以其人对曰：“蔡京不得笔，蔡卞得笔而乏逸韵，蔡襄勒字，沈辽排字，黄庭坚描字，苏轼画字。”上复问卿书如何，对曰：“臣书刷字。”","role":"theory","category":"书家评价","note":"召对中以勒排描画刷比较宋诸家笔法","contextStatus":"complete"},{"start":1908,"end":1910,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":1910,"end":2156,"quote":"米芾（一〇五一年——一一〇七年），北宋书画家。初名黻，字元章，号襄阳漫士、海岳外史等。世居太原（今属山西），迁襄阳（今属湖北），后定居润州（今江苏镇江）。曾任书画学博士和礼部员外郎，人称“米南宫”。又因狂放，并有洁癖，也叫他“米颠”。能诗文，擅书画，精于鉴别，好收藏名迹。行草书能取前人所长，尤得力于王献之，用笔俊迈，有“风樯阵马、沉着痛快”之评，与蔡襄、苏轼、黄庭坚合称“宋四家”。存世法书有《苕溪诗》、《蜀素帖》、《虹县诗》、《向太后挽词》等，著有《书史》、《画史》、《宝章待访录》等。\n","role":"biography","category":"生平资料","note":"编者记米芾身世仕履、性情、书画师承及作品著录。","contextStatus":"complete"},{"start":2156,"end":2158,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2158,"end":2244,"quote":"《海岳名言》一卷，皆其平日论书之语，常有独到处。于古人多所讥贬，其中有过刻处，后人已有批评。其心得既深，所言运笔布格之法，实能脱落蹊径，为书家之圭臬，信临池者所宜探索者。\n","role":"editorial","category":"编者题解","note":"说明《海岳名言》平日论书辑语，兼评讥古过刻与笔法布格心得。","contextStatus":"complete"},{"start":2244,"end":2246,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":2246,"end":2324,"quote":"智永砚成臼，乃能到右军。若穿透，始到锺、索也。可不勉之！\n一日不书便觉思涩，想古人未尝片时废书也。因思苏之才，《桓公至洛帖》字明意殊有工，为天下法书第一。\n","role":"theory","category":"学书方法","note":"以智永砚臼劝勤学，述一日不书思涩并赏《桓公至洛帖》。","contextStatus":"complete"}],"candidates":[{"id":"W20107-0001","start":5,"end":71,"quote":"历观前贤论书，征引迂远，比况奇巧，如“龙跳天门，虎卧凤阁”，是何等语？或遣辞求工，去法逾远，无益学者。故吾所论，要在入人，不为溢辞。","category":"论争辨析","note":"反对迂远比况和溢辞，主张论书有益学者","contextStatus":"complete"},{"id":"W20107-0002","start":73,"end":170,"quote":"吾书小字行书，有如大字。唯家藏真迹跋尾，间或有之，不以与求书者。心既贮之，随意落笔，皆得自然，备其古雅。壮岁未能立家，人谓吾书为集古字，盖取诸长处总而成之。既老始自成家，人见之，不知以何为祖也。","category":"学书方法","note":"自述集古诸长至自成一家，论自然古雅","contextStatus":"complete"},{"id":"W20107-0003","start":172,"end":246,"quote":"江南吴、登州王子韶，大隶题榜有古意，吾儿友仁大隶题榜与之等。又幼儿友知代吾名书碑及手大字更无辨。门下许侍郎尤爱其小楷，云每小简可使令嗣书，谓友知也。","category":"书家评价","note":"评吴王及友仁友知题榜、小楷与代笔相似","contextStatus":"complete"},{"id":"W20107-0004","start":248,"end":331,"quote":"老杜作《薛稷慧普寺》诗云：“郁郁三大字，蛟龙岌相缠。”今有石本得视之，乃是勾勒倒收笔锋，笔笔如蒸饼，“普”字如人握两拳，伸臂而立，丑怪难状。由是论之，古无真大字明矣。","category":"作品评价","note":"批评《慧普寺》榜字勾勒、圆笔与形态","contextStatus":"complete"},{"id":"W20107-0005","start":333,"end":430,"quote":"葛洪“天台之观”飞白，为大字之冠、古今第一。欧阳询“道林之寺”，寒俭无精神。柳公权国清寺，大小不相称，费尽筋骨。裴休率意写牌，乃有真趣，不陷丑怪。真字甚易，唯有体势难，谓不如画算，勾，其势活也。","category":"作品评价","note":"比较诸寺榜字飞白、精神与体势","contextStatus":"complete"},{"id":"W20107-0006","start":432,"end":505,"quote":"字之八面，唯尚真楷见之，大小各自有分。智永有八面已少钟法。丁道护，欧、虞笔始勾，古法亡矣。柳公权师欧，不及远甚，而为丑怪恶札之祖。自柳世始有俗书。","category":"书家评价","note":"以八面与钟法评智永丁欧虞柳，辨古俗","contextStatus":"complete"},{"id":"W20107-0007","start":507,"end":573,"quote":"唐官告在世，为褚、陆、徐、峤之体，殊有不俗者。开元已来，缘明皇字体肥俗，始有徐浩以合时君所好，经生字亦自此肥，开元已前古气无复有矣。","category":"书史书体","note":"论开元以来官诰与经生字的肥俗风尚","contextStatus":"complete"},{"id":"W20107-0008","start":575,"end":661,"quote":"唐人以徐浩比僧虔，甚失当。浩大小一伦，犹吏楷也。僧虔，萧子云传钟法，与子敬无异，大小各有分，不一伦。徐浩为颜真卿辟客书韵，自张颠血脉来，教颜大字促令小，小字展令大，非古也。","category":"书家评价","note":"辨徐浩与僧虔子云优劣，批评大小展促","contextStatus":"complete"},{"id":"W20107-0009","start":663,"end":841,"quote":"石刻不可学，但自书使人刻之已非己书也，故必须真迹观之乃得趣。如颜真卿，每使家僮刻字，故会主人意，修改披撇，致大失真。唯吉州庐山题名，题讫而去，后人刻之，故皆得其真，无做作凡差，乃知颜出于褚也。又真迹皆无蚕头燕尾之笔，《与郭知运争坐位帖》有篆籀气，颜杰思也。柳与欧为丑怪恶札祖，其弟公绰乃不俗于兄，筋骨之说出于柳。世人但以怒张为筋骨，不知不怒张，自有筋骨焉。","category":"学书方法","note":"倡观真迹而不学失真石刻，兼评颜柳欧与筋骨","contextStatus":"complete"},{"id":"W20107-0010","start":843,"end":890,"quote":"凡大字要如小字，小字要如大字。褚遂良小字如大字，其后经生祖述，间有造妙者。大字如小字未之见也。","category":"结体章法","note":"论大小字相通的体势尺度，举褚为例","contextStatus":"complete"},{"id":"W20107-0011","start":892,"end":971,"quote":"世人多写大字时用力捉笔，字愈无筋骨神气，作圆笔头如蒸饼大，可鄙笑。要须如小字锋势备全，都无刻意做作，乃佳。自古及今，余不敏，实得之榜字，固已满世自有识者知之。","category":"用笔技法","note":"反对大字用力捉笔与造作，要求锋势全备","contextStatus":"complete"},{"id":"W20107-0012","start":973,"end":1118,"quote":"石曼卿作佛号，都无回互转折之势，小字展令大，大字促令小，是颠教颜真卿谬论。盖字自有大小相称，且如写太一之殿，作四窠分，岂可将一字肥满一窠，以对殿字乎？盖自有相称大小，不展促也。余尝书天庆之观，天、之字皆四笔，庆、观字多画在下，各随其相称写之，挂起气势自带过，皆如大小一般，虽真有飞动之势也。","category":"结体章法","note":"反对机械展促，以太一及天庆榜字论大小相称","contextStatus":"complete"},{"id":"W20107-0013","start":1120,"end":1175,"quote":"书至隶兴，大篆古法大坏矣。篆籀各随字形大小，故知百物之状，活动圆备，各各自足，隶乃始有展促之势，而三代法亡矣。","category":"书史书体","note":"从篆籀转隶的大小展促变化论古法存亡","contextStatus":"complete"},{"id":"W20107-0014","start":1177,"end":1321,"quote":"欧、虞、褚、柳、颜皆一笔书也。安排费工，岂能垂世。李邕脱子敬，体乏纤浓。徐浩晚年力过，更无气骨，皆不如作郎官时婺州碑也。董孝子不空皆晚年恶札，全无妍媚，此自有识者知之；沈传师变格，自有超世真趣，徐不及也；御史萧诚书太原题名，唐人无出其右，为《司马系南岳真君观碑》，极有钟王趣，余皆不及矣。","category":"书家评价","note":"批评唐诸家安排费工，评徐浩沈萧等风格及作品","contextStatus":"complete"},{"id":"W20107-0015","start":1323,"end":1363,"quote":"智永临集千文，秀润圆劲，八面具备，有真迹。自颠沛字起在唐林夫处，他人所收不及也。","category":"作品评价","note":"评智永《千文》秀润圆劲及传本优劣","contextStatus":"complete"},{"id":"W20107-0016","start":1365,"end":1439,"quote":"字要骨格，肉须裹筋，筋须藏肉，帖乃秀润生布置，稳不俗，险不怪，老不枯，润不肥。变态贵形不贵苦，苦生怒，怒生怪；贵形不贵作，作入画，画入俗：皆字病也。","category":"审美风格","note":"论骨肉相裹、稳险老润与怒怪画俗之病","contextStatus":"complete"},{"id":"W20107-0017","start":1441,"end":1546,"quote":"“少成若天性，习惯若自然。”兹古语也。吾梦古衣冠人授以摺纸书，书法自此差进。写与他人，都不晓。蔡元长见而惊曰：“法何太遽异耶？”此公亦具眼人。章子厚以真自名，独称吾行草，欲吾书如排算子，然真字须有体势，乃佳尔。","category":"学书方法","note":"借习惯、授法与他评论楷书体势，混合梦境轶事","contextStatus":"complete"},{"id":"W20107-0018","start":1548,"end":1562,"quote":"颜鲁公行字可教，真便入俗品。","category":"书家评价","note":"评颜行可教而真入俗","contextStatus":"complete"},{"id":"W20107-0019","start":1564,"end":1591,"quote":"尹仁等古人书，不知此学吾书多。小儿作草书，大假有意思。","category":"书家评价","note":"评儿子学古实际多学己书及草书意味","contextStatus":"complete"},{"id":"W20107-0020","start":1593,"end":1621,"quote":"智永砚成臼，乃能到右军；若穿透，始到钟、索也。可永勉之。","category":"学书方法","note":"以智永磨砚比拟功力并劝勉","contextStatus":"complete"},{"id":"W20107-0021","start":1623,"end":1672,"quote":"一日不书，便觉思涩。想古人未尝片时废书也。因思苏之才《恒公至洛帖》字明意，殊有工，为天下法书第一。","category":"学书方法","note":"论每日不废书，兼推《恒公至洛帖》为第一","contextStatus":"complete"},{"id":"W20107-0022","start":1674,"end":1714,"quote":"半山庄台上多文公书，今不知存否。文公与杨凝式书人鲜知之。余语其故，公大赏其见鉴。","category":"书家评价","note":"辨王安石书学杨凝式，兼题迹存佚","contextStatus":"complete"},{"id":"W20107-0023","start":1716,"end":1745,"quote":"金陵幕山楼隶榜石，关蔚宗二十一年前书。想六朝宫殿榜皆如是。","category":"书史书体","note":"据幕山楼隶榜推想六朝宫殿题榜形制","contextStatus":"complete"},{"id":"W20107-0024","start":1747,"end":1790,"quote":"薛稷书慧普寺，老杜以为“蛟龙岌相缠”。今见其本，乃如柰重儿，握蒸饼势，信老杜不能书也。","category":"作品评价","note":"批评薛稷榜字并反驳杜诗称誉","contextStatus":"complete"},{"id":"W20107-0025","start":1792,"end":1818,"quote":"学书须得趣，他好但为乃入妙。别为一好萦之，便不工也。","category":"学书方法","note":"主张得趣专一，排除其他嗜好干扰","contextStatus":"complete"},{"id":"W20107-0026","start":1820,"end":1908,"quote":"海岳以书学博士召对。上问本朝以书名世者凡数人。海岳各以其人对曰：“蔡京不得笔，蔡卞得笔而乏逸韵，蔡襄勒字，沈辽排字，黄庭坚描字，苏轼画字。”上复问卿书如何，对曰：“臣书刷字。”","category":"书家评价","note":"召对中以勒排描画刷比较宋诸家笔法","contextStatus":"complete"},{"id":"W20107-0027","start":2246,"end":2324,"quote":"智永砚成臼，乃能到右军。若穿透，始到锺、索也。可不勉之！\n一日不书便觉思涩，想古人未尝片时废书也。因思苏之才，《桓公至洛帖》字明意殊有工，为天下法书第一。\n","category":"学书方法","note":"以智永砚臼劝勤学，述一日不书思涩并赏《桓公至洛帖》。","contextStatus":"complete"}],"contextNotes":[],"summary":"wolai优先标准；仅本地独有段落明确保留。AI初标等待整章通读。","annotationRevi