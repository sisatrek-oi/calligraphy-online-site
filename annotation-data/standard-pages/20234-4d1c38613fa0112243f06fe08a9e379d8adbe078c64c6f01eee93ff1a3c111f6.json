152],[152,153],[153,154],[154,155],[155,156],[156,157],[157,158],[158,159],[159,160],[160,161],[161,162],[162,163],[163,164],[164,165],[165,166],[166,167],[167,168],[168,169],[169,170],[170,171],[171,172],[172,173],[173,174],[181,182],[182,183],[183,184],[184,185],[185,186],[186,187],[187,188],[188,189],[189,190],[190,191],[191,192],[192,193],[193,194],[194,195],[195,196],[196,197],[197,198],[198,199],[199,200],[200,201],[201,202],[202,203],[203,204],[204,205],[205,206],[206,207],[207,208],[208,209],[209,210],[210,211],[211,212],[212,213],[213,214],[214,215],[215,216],[216,217],[217,218],[218,219],[219,220],[220,221],[228,229],[229,230],[230,231],[231,232],[232,233],[233,234],[234,235],[235,236],[236,237],[237,238],[238,239],[239,240],[240,241],[241,242],[242,243],[243,244],[244,245],[245,246],[246,247],[247,248],[248,249],[249,250],[250,251],[251,252],[252,253],[253,254],[254,255],[255,256],[256,257],[257,258],[258,259],[259,260],[260,261],[261,262],[262,263],[263,264],[264,265],[265,266],[266,267],[267,268],[268,269],[276,277],[277,278],[278,279],[279,280]],"legacySource":{"kind":"human-txt","page":821,"part":4,"label":"人工审核原TXT","verifiedBy":"帅睿","verifiedAt":"2026-10-19T12:02:43.448Z","revision":"43e96002560e99823112bef32b2c09f2514cff53bc4cae711b6f2657d33fea7b","textSha256":"43e96002560e99823112bef32b2c09f2514cff53bc4cae711b6f2657d33fea7b","fileSha256":"1185f1a3fa26a44f344bcc8de1c99f9576cacd75c8b6baf2d2fd9087b7e29e57","txtPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-逐页校勘.txt","reviewCsvPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-TXT校验表.csv","reviewJsonPath":"tasks/2026-10-21-review-package-update/batch-02/extracted/member-4-part-4/第4份-初筛进度备份.json"}}]},"segments":[{"start":0,"end":5,"quote":"备魏第十\n","role":"structure","category":"篇章标题","note":"原文标题；供章节顺序与跨页合并定位。","contextStatus":"complete"},{"start":5,"end":7,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":7,"end":136,"quote":"北碑莫盛于魏，莫备于魏。盖乘晋、宋之末运，兼齐、梁之流风，享国既永，艺业自兴。\n孝文黼黻，笃好文术，润色鸿业。故太和之后，碑版尤盛，佳书妙製，率在其时。延昌正光，染被斯畅。考其体裁俊伟，笔气深厚，恢恢乎有太平之象。晋、宋禁碑，周、齐短祚，故言碑者，必称魏也。","role":"theory","category":"书史书体","note":"论北魏国祚、孝文好学与太和后碑版尤盛，解释晋宋禁碑及周齐短祚对存碑的影响。","contextStatus":"complete"},{"start":136,"end":138,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":138,"end":221,"quote":"孝文以前，文学无称，碑版亦不著。今所见者，惟有三碑，道武时则有《秦从造像王金堂题名》，太武时则有《鞏伏龙造像》、《赵琱造像》，皆新出土者也。虽草昧初构，已有王风矣。\n","role":"theory","category":"书史书体","note":"列孝文前道武太武三碑并评草昧已有王风。","contextStatus":"complete"},{"start":221,"end":223,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":223,"end":549,"quote":"太和之后，诸家角出，奇逸则有若《石门铭》，古朴则有若《灵庙》、《鞠彦云》，古茂则有若《晖福寺》，瘦硬则有若《吊比干文》，高美则有若《灵庙碑阴》、《郑道昭碑》、《六十人造像》，峻美则有若《李超》、《司马元兴》，奇古则有若《刘玉》、《皇甫驎》，精能则有若《张猛龙》《贾思伯》《杨翬》，峻宕则有若《张黑女》《马鸣寺》，虚和则有若《刁遵》《司马升》、《高湛》，圆静则有若《法生》《刘懿》《敬使君》，亢夷则有若《李仲璇》，庄茂则有若《孙秋生》《长乐王》《太妃侯》《温泉颂》，丰厚则有若《吕望》，方重则有《杨大眼》《魏灵藏》《始平公》，靡逸则有《元详造像》、《优填王》。统观诸碑，若游群玉之山，若行山阴之道，凡后世所有之体格无不备，凡后世所有之意态，亦无不备矣。\n","role":"theory","category":"作品评价","note":"依奇逸古朴瘦硬峻美等风格列太和后诸碑，论魏碑具后世诸体意态。","contextStatus":"complete"},{"start":549,"end":551,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":551,"end":713,"quote":"凡魏碑，随取一家，皆足成体，尽合诸家，则为具美。虽南碑之绵丽，齐碑之逋峭，隋碑之洞达，皆涵盖渟蓄，蕴于其中。故言魏碑，虽无南碑及齐、周、隋碑，亦无不可。\n何言有魏碑可无南碑也？南碑奇古之《宝子》，则有《灵庙碑》似之；高美之《爨龙颜》，峻整之《始兴王碑》，则有《灵庙碑阴》、《张猛龙》、《温泉颂》当之；安茂之《枳阳府君》、《梁","role":"theory","category":"学书方法","note":"主张随取一家成体、尽合诸家具美，以北魏可涵盖南齐隋诸美作取法论证；下页例证缺失。","contextStatus":"needs-context"},{"start":713,"end":715,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":715,"end":742,"quote":"魏开唐，独标俊异。四碑真可出魏碑之外，建标千古者也。\n","role":"theory","category":"作品评价","note":"承缺页结论称齐隋四碑可独立魏外；前页列碑未准入，不在本页推补。","contextStatus":"needs-context"},{"start":742,"end":744,"quote":"\n\n","role":"structure","category":"段落分隔","note":"展示分隔，不替代来源字符","contextStatus":"complete"},{"start":744,"end":950,"quote":"后世称碑之盛者，莫若有唐，名家杰出，诸体并立。然自吾观之，未若魏世也。唐人最讲结构，然向背往来伸缩之法，唐世之碑，孰能比《杨翬》、《贾思伯》、《张猛龙》也！其笔气浑厚，意态跳宕；长短大小，各因其体；分行布白，自妙其致；寓变化于整齐之中，藏奇崛于方平之内：皆极精采。作字工夫，斯为第一，可谓人巧极而天工错矣。以视欧、褚、颜、柳，断凫续鹤以为工，真成可笑。永兴、登善，颇存古意，然实出于魏。各家皆然，略详《导源篇。\n","role":"theory","category":"结体章法","note":"以杨翬贾思伯张猛龙的向背伸缩布白结构变化对比唐碑整齐，评人巧天工俱备。","contextStatus":"complete"}],"candidates":[{"id":"W20234-0001","start":7,"end":136,"quote":"北碑莫盛于魏，莫备于魏。盖乘晋、宋之末运，兼齐、梁之流风，享国既永，艺业自兴。\n孝文黼黻，笃好文术，润色鸿业。故太和之后，碑版尤盛，佳书妙製，率在其时。延昌正光，染被斯畅。考其体裁俊伟，笔气深厚，恢恢乎有太平之象。晋、宋禁碑，周、齐短祚，故言碑者，必称魏也。","category":"书史书体","note":"论北魏国祚、孝文好学与太和后碑版尤盛，解释晋宋禁碑及周齐短祚对存碑的影响。","contextStatus":"complete"},{"id":"W20234-0002","start":138,"end":221,"quote":"孝文以前，文学无称，碑版亦不著。今所见者，惟有三碑，道武时则有《秦从造像王金堂题名》，太武时则有《鞏伏龙造像》、《赵琱造像》，皆新出土者也。虽草昧初构，已有王风矣。\n","category":"书史书体","note":"列孝文前道武太武三碑并评草昧已有王风。","contextStatus":"complete"},{"id":"W20234-0003","start":223,"end":549,"quote":"太和之后，诸家角出，奇逸则有若《石门铭》，古朴则有若《灵庙》、《鞠彦云》，古茂则有若《晖福寺》，瘦硬则有若《吊比干文》，高美则有若《灵庙碑阴》、《郑道昭碑》、《六十人造像》，峻美则有若《李超》、《司马元兴》，奇古则有若《刘玉》、《皇甫驎》，精能则有若《张猛龙》《贾思伯》《杨翬》，峻宕则有若《张黑女》《马鸣寺》，虚和则有若《刁遵》《司马升》、《高湛》，圆静则有若《法生》《刘懿》《敬使君》，亢夷则有若《李仲璇》，庄茂则有若《孙秋生》《长乐王》《太妃侯》《温泉颂》，丰厚则有若《吕望》，方重则有《杨大眼》《魏灵藏》《始平公》，靡逸则有《元详造像》、《优填王》。统观诸碑，若游群玉之山，若行山阴之道，凡后世所有之体格无不备，凡后世所有之意态，亦无不备矣。\n","category":"作品评价","note":"依奇逸古朴瘦硬峻美等风格列太和后诸碑，论魏碑具后世诸体意态。","contextStatus":"complete"},{"id":"W20234-0004","start":551,"end":713,"quote":"凡魏碑，随取一家，皆足成体，尽合诸家，则为具美。虽南碑之绵丽，齐碑之逋峭，隋碑之洞达，皆涵盖渟蓄，蕴于其中。故言魏碑，虽无南碑及齐、周、隋碑，亦无不可。\n何言有魏碑可无南碑也？南碑奇古之《宝子》，则有《灵庙碑》似之；高美之《爨龙颜》，峻整之《始兴王碑》，则有《灵庙碑阴》、《张猛龙》、《温泉颂》当之；安茂之《枳阳府君》、《梁","category":"学书方法","note":"主张随取一家成体、尽合诸家具美，以北魏可涵盖南齐隋诸美作取法论证；下页例证缺失。","contextStatus":"needs-context"},{"id":"W20234-0005","start":715,"end":742,"quote":"魏开唐，独标俊异。四碑真可出魏碑之外，建标千古者也。\n","category":"作品评价","note":"承缺页结论称齐隋四碑可独立魏外；前页列碑未准入，不在本页推补。","contextStatus":"needs-context"},{"id":"W20234-0006","start":744,"end":950,"quote":"后世称碑之盛者，莫若有唐，名家杰出，诸体并立。然自吾观之，未若魏世也。唐人最讲结构，然向背往来伸缩之法，唐世之碑，孰能比《杨翬》、