# Supabase public client configuration. Never add a service-role key here.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
CLOUD_SYNC_ENABLED=true
REMEMBER_EMAIL_ENABLED=true
DEFAULT_TEAM_NAME=书论研究团队
DEFAULT_PROJECT_NAME=书论整理项目
DEFAULT_WORKSPACE_NAME=书论统一主表
SEARCH_PROVIDER=duckduckgo

# Primary OpenAI Chat Completions-compatible model.
MODEL_PRIMARY_API_URL=https://api.example.com/v1/chat/completions
MODEL_PRIMARY_API_KEY=replace-me
MODEL_PRIMARY_NAME=model-primary
MODEL_PRIMARY_FAMILY=provider-a

# Secondary model. Use a genuinely different model family when possible.
MODEL_SECONDARY_API_URL=https://api.example.com/v1/chat/completions
MODEL_SECONDARY_API_KEY=replace-me
MODEL_SECONDARY_NAME=model-secondary
MODEL_SECONDARY_FAMILY=provider-b

# Tertiary model.
MODEL_TERTIARY_API_URL=https://api.example.com/v1/chat/completions
MODEL_TERTIARY_API_KEY=replace-me
MODEL_TERTIARY_NAME=model-tertiary
MODEL_TERTIARY_FAMILY=provider-c

# Safe defaults: human-assisted review with evidence-backed consensus.
MODEL_REVIEW_MODE=assist
MODEL_DEFAULT_CONSENSUS=standard
AI_AUTH_REQUIRED=true

# Optional dedicated HMAC secret for stateless retry tokens. Use a long random value.
# If omitted, the backend derives a key from the three server-only model API keys.
CONSENSUS_SNAPSHOT_SECRET=replace-with-a-long-random-secret
